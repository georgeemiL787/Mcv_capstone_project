@{
    ViewData["Title"] = "Account Security - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/account-security.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">GE</div>
            </div>
            <h3>George Emil</h3>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="account-security-container">
    <div class="account-security-header">
        <h1>Account Security</h1>
        <p>Protect your account with advanced security features</p>
    </div>
    
    <div class="security-overview">
        <div class="security-score">
            <div class="score-circle">
                <span class="score-value">85</span>
                <span class="score-label">Security Score</span>
            </div>
            <div class="score-details">
                <h3>Good Security Level</h3>
                <p>Your account has good security measures in place. Consider enabling additional features for enhanced protection.</p>
            </div>
        </div>
    </div>
    
    <div class="security-sections">
        <div class="security-section">
            <div class="section-header">
                <h3>Password & Authentication</h3>
                <p>Manage your login credentials and authentication methods</p>
            </div>
            <div class="security-options">
                <div class="security-option">
                    <div class="option-info">
                        <h4>Change Password</h4>
                        <p>Update your account password regularly for better security</p>
                        <span class="last-updated">Last updated: 2 months ago</span>
                    </div>
                    <button class="btn-primary">Change Password</button>
                </div>
                
                <div class="security-option">
                    <div class="option-info">
                        <h4>Two-Factor Authentication</h4>
                        <p>Add an extra layer of security with 2FA</p>
                        <span class="status enabled">Enabled</span>
                    </div>
                    <button class="btn-secondary">Manage 2FA</button>
                </div>
                
                <div class="security-option">
                    <div class="option-info">
                        <h4>Login History</h4>
                        <p>Review recent login attempts and device activity</p>
                        <span class="last-checked">Last checked: 1 week ago</span>
                    </div>
                    <button class="btn-secondary">View History</button>
                </div>
            </div>
        </div>
        
        <div class="security-section">
            <div class="section-header">
                <h3>Device Management</h3>
                <p>Control which devices can access your account</p>
            </div>
            <div class="device-list">
                <div class="device-item current">
                    <div class="device-info">
                        <div class="device-icon">
                            <span class="material-symbols-outlined">computer</span>
                        </div>
                        <div class="device-details">
                            <h4>Windows PC - Chrome</h4>
                            <p>Current device • Last active: Now</p>
                            <span class="device-location">New York, NY, USA</span>
                        </div>
                    </div>
                    <div class="device-status">
                        <span class="status-badge current">Current</span>
                    </div>
                </div>
                
                <div class="device-item">
                    <div class="device-info">
                        <div class="device-icon">
                            <span class="material-symbols-outlined">smartphone</span>
                        </div>
                        <div class="device-details">
                            <h4>iPhone 13 - Safari</h4>
                            <p>Last active: 2 hours ago</p>
                            <span class="device-location">New York, NY, USA</span>
                        </div>
                    </div>
                    <div class="device-actions">
                        <button class="btn-secondary">Remove</button>
                    </div>
                </div>
                
                <div class="device-item">
                    <div class="device-info">
                        <div class="device-icon">
                            <span class="material-symbols-outlined">computer</span>
                        </div>
                        <div class="device-details">
                            <h4>MacBook Pro - Firefox</h4>
                            <p>Last active: 1 day ago</p>
                            <span class="device-location">San Francisco, CA, USA</span>
                        </div>
                    </div>
                    <div class="device-actions">
                        <button class="btn-secondary">Remove</button>
                    </div>
                </div>
            </div>
            <button class="btn-secondary">Remove All Other Devices</button>
        </div>
        
        <div class="security-section">
            <div class="section-header">
                <h3>Security Alerts</h3>
                <p>Configure how you receive security notifications</p>
            </div>
            <div class="alert-options">
                <div class="alert-option">
                    <div class="option-info">
                        <h4>New Device Login</h4>
                        <p>Get notified when someone logs in from a new device</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
                
                <div class="alert-option">
                    <div class="option-info">
                        <h4>Password Changes</h4>
                        <p>Receive alerts when your password is modified</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
                
                <div class="alert-option">
                    <div class="option-info">
                        <h4>Failed Login Attempts</h4>
                        <p>Get notified of suspicious login attempts</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
                
                <div class="alert-option">
                    <div class="option-info">
                        <h4>Account Recovery</h4>
                        <p>Receive notifications about account recovery requests</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>
        
        <div class="security-section">
            <div class="section-header">
                <h3>Advanced Security</h3>
                <p>Additional security features for enhanced protection</p>
            </div>
            <div class="advanced-options">
                <div class="advanced-option">
                    <div class="option-info">
                        <h4>Session Timeout</h4>
                        <p>Automatically log out after periods of inactivity</p>
                        <span class="current-setting">Current: 30 minutes</span>
                    </div>
                    <select class="timeout-select">
                        <option value="15">15 minutes</option>
                        <option value="30" selected>30 minutes</option>
                        <option value="60">1 hour</option>
                        <option value="120">2 hours</option>
                    </select>
                </div>
                
                <div class="advanced-option">
                    <div class="option-info">
                        <h4>IP Address Restrictions</h4>
                        <p>Limit account access to specific IP addresses</p>
                        <span class="status disabled">Disabled</span>
                    </div>
                    <button class="btn-secondary">Configure</button>
                </div>
                
                <div class="advanced-option">
                    <div class="option-info">
                        <h4>Security Questions</h4>
                        <p>Set up security questions for account recovery</p>
                        <span class="status incomplete">2 of 3 completed</span>
                    </div>
                    <button class="btn-primary">Complete Setup</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="security-actions">
        <button class="btn-primary">Save Security Settings</button>
        <button class="btn-secondary">Run Security Check</button>
        <button class="btn-secondary">Export Security Report</button>
    </div>
    
    <div class="security-tips">
        <h3>Security Best Practices</h3>
        <div class="tips-grid">
            <div class="tip-item">
                <span class="material-symbols-outlined">lock</span>
                <h4>Use Strong Passwords</h4>
                <p>Create unique, complex passwords for each account</p>
            </div>
            
            <div class="tip-item">
                <span class="material-symbols-outlined">verified_user</span>
                <h4>Enable 2FA</h4>
                <p>Two-factor authentication adds an extra security layer</p>
            </div>
            
            <div class="tip-item">
                <span class="material-symbols-outlined">devices</span>
                <h4>Monitor Devices</h4>
                <p>Regularly review and remove unknown devices</p>
            </div>
            
            <div class="tip-item">
                <span class="material-symbols-outlined">update</span>
                <h4>Keep Updated</h4>
                <p>Update your password and security settings regularly</p>
            </div>
        </div>
    </div>
    
    <div class="security-help">
        <h4>Need Help?</h4>
        <p>If you suspect unauthorized access to your account or have security concerns, please <a href="#">contact our security team immediately</a>. You can also review our <a href="#">Security Policy</a> for more information.</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/account-security.js"></script>
}
