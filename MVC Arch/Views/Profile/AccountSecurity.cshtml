@{
    ViewData["Title"] = "Account Security - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/account-security.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">GE</div>
            </div>
            <h3>George Emil</h3>
            <a href="#" class="view-profile-link">View Public Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="account-security-container">
            <div class="account-security-header">
                <h1>Account Security</h1>
                <p>Protect your account with advanced security features</p>
            </div>
            
            <div class="security-overview">
                <div class="security-score">
                    <div class="score-circle">
                        <span class="score-value">85</span>
                        <span class="score-label">Security Score</span>
                    </div>
                    <div class="score-details">
                        <h3>Good Security Level</h3>
                        <p>Your account has good security measures in place. Consider enabling additional features for enhanced protection.</p>
                    </div>
                </div>
            </div>
            
            <div class="security-sections">
                <div class="security-section">
                    <div class="section-header">
                        <h3>Password & Authentication</h3>
                        <p>Manage your login credentials and authentication methods</p>
                    </div>
                    <div class="security-options">
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Change Password</h4>
                                <p>Update your account password regularly for better security</p>
                                <span class="last-updated">Last updated: 2 months ago</span>
                            </div>
                            <button class="btn-primary">Change Password</button>
                        </div>
                        
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Two-Factor Authentication</h4>
                                <p>Add an extra layer of security with 2FA</p>
                                <span class="status enabled">Enabled</span>
                            </div>
                            <button class="btn-secondary">Manage 2FA</button>
                        </div>
                        
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Login Notifications</h4>
                                <p>Get notified when someone logs into your account</p>
                                <span class="status enabled">Enabled</span>
                            </div>
                            <button class="btn-secondary">Settings</button>
                        </div>
                    </div>
                </div>
                
                <div class="security-section">
                    <div class="section-header">
                        <h3>Active Sessions</h3>
                        <p>Monitor and manage your active login sessions</p>
                    </div>
                    <div class="device-list">
                        <div class="device-item current">
                            <div class="device-info">
                                <div class="device-icon">
                                    <span class="material-symbols-outlined">computer</span>
                                </div>
                                <div class="device-details">
                                    <h4>Windows 10 - Chrome</h4>
                                    <p>New York, NY, United States</p>
                                    <span class="device-location">Current session</span>
                                </div>
                            </div>
                            <div class="device-status">
                                <span class="status-badge current">Current</span>
                            </div>
                        </div>
                        
                        <div class="device-item">
                            <div class="device-info">
                                <div class="device-icon">
                                    <span class="material-symbols-outlined">smartphone</span>
                                </div>
                                <div class="device-details">
                                    <h4>iPhone 13 - Safari</h4>
                                    <p>New York, NY, United States</p>
                                    <span class="device-location">Last active: 2 hours ago</span>
                                </div>
                            </div>
                            <div class="device-status">
                                <button class="btn-secondary">Revoke</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="security-section">
                    <div class="section-header">
                        <h3>Security History</h3>
                        <p>Review recent security events and account activities</p>
                    </div>
                    <div class="security-events">
                        <div class="event-item">
                            <div class="event-icon">
                                <span class="material-symbols-outlined">login</span>
                            </div>
                            <div class="event-details">
                                <h4>Successful Login</h4>
                                <p>Windows 10 - Chrome from New York, NY</p>
                                <span class="event-time">Today at 2:30 PM</span>
                            </div>
                        </div>
                        
                        <div class="event-item">
                            <div class="event-icon">
                                <span class="material-symbols-outlined">password</span>
                            </div>
                            <div class="event-details">
                                <h4>Password Changed</h4>
                                <p>Password was successfully updated</p>
                                <span class="event-time">2 months ago</span>
                            </div>
                        </div>
                        
                        <div class="event-item">
                            <div class="event-icon">
                                <span class="material-symbols-outlined">security</span>
                            </div>
                            <div class="event-details">
                                <h4>2FA Enabled</h4>
                                <p>Two-factor authentication was activated</p>
                                <span class="event-time">3 months ago</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}
