@model MCV_Capstone.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile - Full Courses Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                @if (!string.IsNullOrEmpty(Model?.User?.ProfilePhoto))
                {
                    <img src="data:image/jpeg;base64,@Model.User.ProfilePhoto" alt="Profile Photo" class="avatar-image">
                }
                else
                {
                    <div class="avatar-placeholder">
                        @(string.IsNullOrEmpty(Model?.User?.FirstName) || string.IsNullOrEmpty(Model?.User?.LastName) 
                            ? "U" 
                            : $"{Model.User.FirstName[0]}{Model.User.LastName[0]}".ToUpper())
                    </div>
                }
            </div>
            <h3>@(string.IsNullOrEmpty(Model?.User?.FirstName) || string.IsNullOrEmpty(Model?.User?.LastName) 
                ? "User" 
                : $"{Model.User.FirstName} {Model.User.LastName}")</h3>
            <a href="#" class="view-profile-link">View Public Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Profile Section -->
        <div class="content-section">
            <div class="content-header">
                <h1>Profile Settings</h1>
                <p>Manage your personal information and account settings.</p>
            </div>

            <div class="profile-form">
                <div class="form-section">
                    <h3>Personal Information</h3>
                    <form method="post" action="@Url.Action("Index", "Profile")" id="profileForm">
                        @Html.AntiForgeryToken()
                        <div class="form-row">
                            <div class="form-group">
                                <label for="FirstName">First Name <span class="required">*</span></label>
                                <input type="text" id="FirstName" name="FirstName" value="@(Model?.User?.FirstName ?? "")" required maxlength="100" placeholder="Enter your first name">
                                <span asp-validation-for="User.FirstName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="LastName">Last Name <span class="required">*</span></label>
                                <input type="text" id="LastName" name="LastName" value="@(Model?.User?.LastName ?? "")" required maxlength="100" placeholder="Enter your last name">
                                <span asp-validation-for="User.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="Email">Email Address <span class="required">*</span></label>
                            <input type="email" id="Email" name="Email" value="@(Model?.User?.Email ?? "")" required maxlength="255" placeholder="Enter your email address">
                            <span asp-validation-for="User.Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="Phone">Phone Number</label>
                            <input type="tel" id="Phone" name="Phone" value="@(Model?.User?.PhoneNumber ?? "")" maxlength="20" placeholder="Enter your phone number">
                            <span class="text-danger" id="phoneError"></span>
                        </div>

                        <div class="form-group">
                            <label for="Bio">Bio</label>
                            <textarea id="Bio" name="Bio" rows="4" maxlength="1000" placeholder="Tell us about yourself...">@(Model?.User?.Biography ?? "")</textarea>
                            <small class="form-help">Maximum 1000 characters</small>
                            <span asp-validation-for="User.Biography" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="Location">Location</label>
                            <input type="text" id="Location" name="Location" value="@(Model?.User?.Location ?? "")" maxlength="100" placeholder="e.g., New York, NY">
                            <span asp-validation-for="User.Location" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="Headline">Professional Headline</label>
                            <input type="text" id="Headline" name="Headline" value="@(Model?.User?.Headline ?? "")" maxlength="255" placeholder="e.g., Senior Software Developer">
                            <span asp-validation-for="User.Headline" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="Language">Preferred Language</label>
                            <input type="text" id="Language" name="Language" value="@(Model?.User?.Language ?? "English")" maxlength="50" placeholder="e.g., English">
                            <span asp-validation-for="User.Language" class="text-danger"></span>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="save-btn" id="saveBtn">Save Changes</button>
                        </div>
                    </form>
                </div>

                <div class="form-section">
                    <h3>Account Information</h3>
                    <div class="account-info">
                        <div class="info-item">
                            <label>Account Type</label>
                            <span>@(Model?.User?.AccountStatus ?? "Active")</span>
                        </div>
                        <div class="info-item">
                            <label>Member Since</label>
                            <span>@(Model?.MemberSince ?? "Unknown")</span>
                        </div>
                        <div class="info-item">
                            <label>Last Login</label>
                            <span>@(Model?.LastLogin ?? "Never")</span>
                        </div>
                        <div class="info-item">
                            <label>Courses Completed</label>
                            <span>@(Model?.CoursesCompleted ?? 0)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
} 