@{
    ViewData["Title"] = "Notification Preferences - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/notification-preferences.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">GE</div>
            </div>
            <h3>George Emil</h3>
            <a href="#" class="view-profile-link">View Public Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="notification-container">
            <div class="notification-header">
                <h1>Notification Preferences</h1>
                <p>Customize how and when you receive notifications</p>
            </div>

            <div class="notification-section">
                <div class="email-notifications">
                    <h3>Email Notifications</h3>
                    <div class="notification-settings">
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Course Updates</h4>
                                <p>Get notified about new content and course updates</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Learning Reminders</h4>
                                <p>Receive reminders to continue your learning journey</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Marketing Communications</h4>
                                <p>Receive updates about new features and promotions</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Security Alerts</h4>
                                <p>Get notified about account security events</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="email-notifications">
                    <h3>Notification Frequency</h3>
                    <div class="form-group">
                        <label for="frequency">Email Frequency</label>
                        <select id="frequency" class="frequency-select">
                            <option value="daily">Daily Digest</option>
                            <option value="weekly" selected>Weekly Summary</option>
                            <option value="monthly">Monthly Report</option>
                            <option value="never">Never</option>
                        </select>
                    </div>
                </div>

                <div class="email-notifications">
                    <h3>Push Notifications</h3>
                    <div class="notification-settings">
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Course Progress</h4>
                                <p>Get push notifications for course milestones</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>New Messages</h4>
                                <p>Receive notifications for new messages and comments</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>System Updates</h4>
                                <p>Get notified about platform maintenance and updates</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="email-notifications">
                    <h3>Quiet Hours</h3>
                    <div class="quiet-hours-settings">
                        <div class="form-group">
                            <label for="quietStart">Start Time</label>
                            <input type="time" id="quietStart" value="22:00">
                        </div>
                        <div class="form-group">
                            <label for="quietEnd">End Time</label>
                            <input type="time" id="quietEnd" value="08:00">
                        </div>
                        <div class="security-option">
                            <div class="option-info">
                                <h4>Enable Quiet Hours</h4>
                                <p>Pause notifications during specified hours</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}

