@{
    ViewData["Title"] = "Subscriptions - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/subscriptions.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">GE</div>
            </div>
            <h3>George Emil</h3>
            <a href="#" class="view-profile-link">View Public Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="subscriptions-container">
            <div class="subscriptions-header">
                <h1>Subscriptions</h1>
                <p>Manage your subscription plans and billing information</p>
            </div>

            <div class="current-subscription">
                <div class="subscription-card active">
                    <div class="subscription-header">
                        <h3>Premium Student Plan</h3>
                        <span class="subscription-status active">Active</span>
                    </div>
                    <div class="subscription-details">
                        <div class="plan-features">
                            <h4>Plan Features</h4>
                            <ul>
                                <li>Access to all premium courses</li>
                                <li>Unlimited course downloads</li>
                                <li>Priority support</li>
                                <li>Certificate of completion</li>
                                <li>Mobile app access</li>
                            </ul>
                        </div>
                        <div class="plan-pricing">
                            <div class="price">$19<span class="currency">.99</span></div>
                            <div class="period">per month</div>
                            <div class="billing-cycle">Billed monthly</div>
                            <div class="next-billing">Next billing: December 15, 2024</div>
                        </div>
                    </div>
                    <div class="subscription-actions">
                        <button class="btn-secondary">Change Plan</button>
                        <button class="btn-secondary">Cancel</button>
                    </div>
                </div>
            </div>

            <div class="available-plans">
                <h3>Available Plans</h3>
                <div class="plans-grid">
                    <div class="plan-card">
                        <div class="plan-header">
                            <h4>Basic Plan</h4>
                            <div class="plan-price">$9.99<span class="period">/month</span></div>
                        </div>
                        <ul class="plan-features">
                            <li>Access to basic courses</li>
                            <li>Limited downloads</li>
                            <li>Standard support</li>
                        </ul>
                        <button class="btn-secondary">Switch to Basic</button>
                    </div>
                    
                    <div class="plan-card featured">
                        <div class="plan-badge">Most Popular</div>
                        <div class="plan-header">
                            <h4>Premium Student</h4>
                            <div class="plan-price">$19.99<span class="period">/month</span></div>
                        </div>
                        <ul class="plan-features">
                            <li>Access to all premium courses</li>
                            <li>Unlimited downloads</li>
                            <li>Priority support</li>
                            <li>Certificate of completion</li>
                            <li>Mobile app access</li>
                        </ul>
                        <button class="btn-primary">Current Plan</button>
                    </div>
                    
                    <div class="plan-card">
                        <div class="plan-header">
                            <h4>Professional</h4>
                            <div class="plan-price">$39.99<span class="period">/month</span></div>
                        </div>
                        <ul class="plan-features">
                            <li>Everything in Premium</li>
                            <li>1-on-1 mentoring</li>
                            <li>Custom learning paths</li>
                            <li>Advanced analytics</li>
                            <li>Team collaboration tools</li>
                        </ul>
                        <button class="btn-secondary">Upgrade to Pro</button>
                    </div>
                </div>
            </div>

            <div class="billing-history">
                <h3>Billing History</h3>
                <div class="billing-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Nov 15, 2024</td>
                                <td>Premium Student Plan - Monthly</td>
                                <td>$19.99</td>
                                <td><span class="status-badge paid">Paid</span></td>
                            </tr>
                            <tr>
                                <td>Oct 15, 2024</td>
                                <td>Premium Student Plan - Monthly</td>
                                <td>$19.99</td>
                                <td><span class="status-badge paid">Paid</span></td>
                            </tr>
                            <tr>
                                <td>Sep 15, 2024</td>
                                <td>Premium Student Plan - Monthly</td>
                                <td>$19.99</td>
                                <td><span class="status-badge paid">Paid</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="subscription-actions-footer">
                <button class="btn-primary">Download Invoice</button>
                <button class="btn-secondary">Contact Support</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}
