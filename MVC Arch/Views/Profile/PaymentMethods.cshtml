@{
    ViewData["Title"] = "Payment Methods - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/payment-methods.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                @if (!string.IsNullOrEmpty(Model?.User?.ProfilePhoto))
            {
                <img src="data:image/jpeg;base64,@Model.User.ProfilePhoto" alt="Profile Photo" class="avatar-image">
            }
            else
            {
                <div class="avatar-placeholder">
                    @(Model?.User?.FirstName?.Length > 0 ? Model.User.FirstName[0].ToString().ToUpper() : "U")
                    @(Model?.User?.LastName?.Length > 0 ? Model.User.LastName[0].ToString().ToUpper() : "")
                </div>
            }
            </div>
            <h3>George Emil</h3>
            <a href="#" class="view-profile-link">View Public Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="payment-methods-container">
            <div class="payment-methods-header">
                <h1>Payment Methods</h1>
                <p>Manage your saved payment methods and billing information</p>
            </div>

            <div class="saved-methods">
                <h3>Saved Payment Methods</h3>
                <div class="methods-list">
                    <div class="method-item">
                        <div class="method-info">
                            <div class="method-icon">
                                <span class="material-symbols-outlined">credit_card</span>
                            </div>
                            <div class="method-details">
                                <h4>Visa ending in 1234</h4>
                                <p>Expires 12/25</p>
                            </div>
                        </div>
                        <div class="method-actions">
                            <button class="btn-secondary">Edit</button>
                            <button class="btn-secondary">Remove</button>
                        </div>
                    </div>
                    
                    <div class="method-item">
                        <div class="method-info">
                            <div class="method-icon">
                                <span class="material-symbols-outlined">account_balance</span>
                            </div>
                            <div class="method-details">
                                <h4>Bank Account ending in 5678</h4>
                                <p>Chase Bank</p>
                            </div>
                        </div>
                        <div class="method-actions">
                            <button class="btn-secondary">Edit</button>
                            <button class="btn-secondary">Remove</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="payment-form">
                <h3>Add New Payment Method</h3>
                <form>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cardNumber">Card Number</label>
                            <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" required>
                        </div>
                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input type="text" id="expiryDate" placeholder="MM/YY" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" placeholder="123" required>
                        </div>
                        <div class="form-group">
                            <label for="cardholderName">Cardholder Name</label>
                            <input type="text" id="cardholderName" placeholder="John Doe" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="billingAddress">Billing Address</label>
                        <input type="text" id="billingAddress" placeholder="123 Main St, City, State ZIP" required>
                    </div>
                    <button type="submit" class="add-card-btn">Add Payment Method</button>
                </form>
            </div>

            <div class="security-info">
                <h3>Security & Privacy</h3>
                <div class="security-items">
                    <div class="security-item">
                        <span class="material-symbols-outlined security-icon">security</span>
                        <div class="security-text">
                            <h4>Secure Transactions</h4>
                            <p>All payment information is encrypted and securely stored</p>
                        </div>
                    </div>
                    <div class="security-item">
                        <span class="material-symbols-outlined security-icon">lock</span>
                        <div class="security-text">
                            <h4>PCI Compliant</h4>
                            <p>We follow industry standards for payment security</p>
                        </div>
                    </div>
                    <div class="security-item">
                        <span class="material-symbols-outlined security-icon">verified_user</span>
                        <div class="security-text">
                            <h4>Fraud Protection</h4>
                            <p>Advanced fraud detection systems protect your transactions</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}
