@{
    ViewData["Title"] = "Payment Methods - Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/profile-shared.css">
    <link rel="stylesheet" href="~/css/payment-methods.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<div class="profile-layout">
    <!-- Left Sidebar -->
    <div class="profile-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">GE</div>
            </div>
            <h3>George Emil</h3>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Profile")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="profile">
                <span class="material-symbols-outlined nav-icon">person</span>
                Profile
            </a>
            <a href="@Url.Action("Photo", "Profile")" class="nav-item @(currentAction == "photo" ? "active" : "")" data-page="photo">
                <span class="material-symbols-outlined nav-icon">photo_camera</span>
                Photo
            </a>
            <a href="@Url.Action("AccountSecurity", "Profile")" class="nav-item @(currentAction == "accountsecurity" ? "active" : "")" data-page="account-security">
                <span class="material-symbols-outlined nav-icon">security</span>
                Account Security
            </a>
            <a href="@Url.Action("Subscriptions", "Profile")" class="nav-item @(currentAction == "subscriptions" ? "active" : "")" data-page="subscriptions">
                <span class="material-symbols-outlined nav-icon">subscriptions</span>
                Subscriptions
            </a>
            <a href="@Url.Action("PaymentMethods", "Profile")" class="nav-item @(currentAction == "paymentmethods" ? "active" : "")" data-page="payment-methods">
                <span class="material-symbols-outlined nav-icon">account_balance_wallet</span>
                Payment Methods
            </a>
            <a href="@Url.Action("Privacy", "Profile")" class="nav-item @(currentAction == "privacy" ? "active" : "")" data-page="privacy">
                <span class="material-symbols-outlined nav-icon">lock</span>
                Privacy
            </a>
            <a href="@Url.Action("NotificationPreferences", "Profile")" class="nav-item @(currentAction == "notificationpreferences" ? "active" : "")" data-page="notification-preferences">
                <span class="material-symbols-outlined nav-icon">notifications</span>
                Notification Preferences
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="profile-content">
        <div class="payment-methods-container">
            <div class="payment-methods-header">
                <h1>Payment Methods</h1>
                <p>Manage your payment options for course purchases and subscriptions</p>
                <button class="btn-primary" id="addPaymentMethod">
                    <span class="material-symbols-outlined">add</span>
                    Add Payment Method
                </button>
            </div>
            
            <div class="payment-methods-list">
                <div class="payment-method-card">
                    <div class="method-info">
                        <div class="method-icon">
                            <span class="material-symbols-outlined">credit_card</span>
                        </div>
                        <div class="method-details">
                            <h3>Visa ending in 4242</h3>
                            <p>Expires 12/26 • Default payment method</p>
                        </div>
                    </div>
                    <div class="method-actions">
                        <button class="btn-secondary">Edit</button>
                        <button class="btn-danger">Remove</button>
                    </div>
                </div>
                
                <div class="payment-method-card">
                    <div class="method-info">
                        <div class="method-icon">
                            <span class="material-symbols-outlined">credit_card</span>
                        </div>
                        <div class="method-details">
                            <h3>Mastercard ending in 8888</h3>
                            <p>Expires 08/25</p>
                        </div>
                    </div>
                    <div class="method-actions">
                        <button class="btn-secondary">Edit</button>
                        <button class="btn-danger">Remove</button>
                    </div>
                </div>
                
                <div class="payment-method-card">
                    <div class="method-info">
                        <div class="method-icon">
                            <span class="material-symbols-outlined">account_balance</span>
                        </div>
                        <div class="method-details">
                            <h3>Bank Account</h3>
                            <p>Chase Bank • Account ending in 1234</p>
                        </div>
                    </div>
                    <div class="method-actions">
                        <button class="btn-secondary">Edit</button>
                        <button class="btn-danger">Remove</button>
                    </div>
                </div>
            </div>
            
            <div class="add-payment-method" id="addPaymentForm" style="display: none;">
                <h3>Add New Payment Method</h3>
                <form class="payment-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cardNumber">Card Number</label>
                            <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19">
                        </div>
                        <div class="form-group">
                            <label for="cardholderName">Cardholder Name</label>
                            <input type="text" id="cardholderName" placeholder="John Doe">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input type="text" id="expiryDate" placeholder="MM/YY" maxlength="5">
                        </div>
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" placeholder="123" maxlength="4">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="billingAddress">Billing Address</label>
                        <input type="text" id="billingAddress" placeholder="123 Main St, City, State 12345">
                    </div>
                    
                    <div class="form-group">
                        <label class="checkbox-container">
                            <input type="checkbox" id="setAsDefault">
                            <span class="checkmark"></span>
                            Set as default payment method
                        </label>
                    </div>
                    
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" id="cancelAdd">Cancel</button>
                        <button type="submit" class="btn-primary">Add Payment Method</button>
                    </div>
                </form>
            </div>
            
            <div class="payment-security">
                <h3>Security & Privacy</h3>
                <div class="security-features">
                    <div class="security-item">
                        <span class="material-symbols-outlined">security</span>
                        <div>
                            <h4>Secure Encryption</h4>
                            <p>All payment information is encrypted using industry-standard SSL encryption</p>
                        </div>
                    </div>
                    
                    <div class="security-item">
                        <span class="material-symbols-outlined">verified_user</span>
                        <div>
                            <h4>PCI Compliant</h4>
                            <p>We maintain PCI DSS compliance to ensure your payment data is secure</p>
                        </div>
                    </div>
                    
                    <div class="security-item">
                        <span class="material-symbols-outlined">lock</span>
                        <div>
                            <h4>Tokenized Storage</h4>
                            <p>Payment details are tokenized and never stored in plain text</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="billing-preferences">
                <h3>Billing Preferences</h3>
                <div class="preferences-options">
                    <div class="preference-item">
                        <div class="preference-info">
                            <h4>Automatic Billing</h4>
                            <p>Automatically charge your default payment method for subscriptions</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="slider"></span>
                        </label>
                    </div>
                    
                    <div class="preference-item">
                        <div class="preference-info">
                            <h4>Email Receipts</h4>
                            <p>Send email receipts for all transactions</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="slider"></span>
                        </label>
                    </div>
                    
                    <div class="preference-item">
                        <div class="preference-info">
                            <h4>Low Balance Alerts</h4>
                            <p>Notify me when my payment method has low funds</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox">
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>
            
            <div class="payment-help">
                <h3>Need Help?</h3>
                <div class="help-options">
                    <div class="help-item">
                        <span class="material-symbols-outlined">support_agent</span>
                        <h4>Contact Support</h4>
                        <p>Get help with payment issues or questions</p>
                        <button class="btn-secondary">Contact Us</button>
                    </div>
                    
                    <div class="help-item">
                        <span class="material-symbols-outlined">help</span>
                        <h4>Payment FAQ</h4>
                        <p>Find answers to common payment questions</p>
                        <button class="btn-secondary">View FAQ</button>
                    </div>
                    
                    <div class="help-item">
                        <span class="material-symbols-outlined">description</span>
                        <h4>Billing Policy</h4>
                        <p>Learn about our billing and refund policies</p>
                        <button class="btn-secondary">Read Policy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payment-methods.js"></script>
}
