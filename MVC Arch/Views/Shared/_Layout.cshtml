@using MCV_Capstone.Services
@inject ISessionHelper SessionHelper
@inject IUserAvatarService UserAvatarService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCV_Capstone</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MCV_Capstone.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header Navigation -->
    <nav id="header-nav">
        <div class="nav-left">
            <img src="~/assets/images/luIZ_without_bg.png" alt="LuIZ Learning" onclick="window.location.href='@Url.Action("Index", "Home")'" style="cursor: pointer;">
        </div>
        
        <div class="nav-center">
            <ul class="nav-menu">
                <li><a href="@Url.Action("Index", "OurCourses")" class="nav-link">Courses</a></li>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a href="@Url.Action("Index", "AdminPanel")" class="nav-link">Admin Panel</a></li>
                    }
                    else if (User.IsInRole("Instructor"))
                    {
                        <li><a href="@Url.Action("Index", "InstructorDashboard")" class="nav-link">Instructor Dashboard</a></li>
                    }
                    else
                    {
                        <!-- Student/Company role navigation -->
                        <li><a href="@Url.Action("Index", "CareerSimulator")" class="nav-link">Career Simulator</a></li>
                        <li><a href="@Url.Action("Index", "QuizCenter")" class="nav-link">Quiz Center</a></li>
                        <li><a href="@Url.Action("Index", "Leaderboard")" class="nav-link">Leaderboard</a></li>
                    }
                }
                else
                {
                    <!-- Guest user navigation -->
                    <li><a href="@Url.Action("Index", "CareerSimulator")" class="nav-link">Career Simulator</a></li>
                    <li><a href="@Url.Action("Index", "QuizCenter")" class="nav-link">Quiz Center</a></li>
                    <li><a href="@Url.Action("Index", "Leaderboard")" class="nav-link">Leaderboard</a></li>
                }
                
                <li><a href="@Url.Action("Index", "Contact")" class="nav-link">Contact</a></li>
            </ul>
        </div>
        
        <div class="nav-right">
            <form id="search-bar" action="@Url.Action("Index", "OurCourses")" method="get">
                <div>
                    <input type="text" name="searchTerm" placeholder="Search for courses..." class="search-input" id="global-search-input">
                    <button type="submit" class="search-submit-btn">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </form>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- User Profile Section (when logged in) -->
                <div class="user-profile-section" id="user-profile-section">
                    <div class="user-avatar" onclick="toggleProfileDropdown()">
                        @{
                            var userAvatar = await UserAvatarService.GetCurrentUserAvatarAsync();
                            var userInitials = SessionHelper.IsAuthenticated() ? 
                                (SessionHelper.GetUserFirstName()?.Length > 0 ? SessionHelper.GetUserFirstName()[0].ToString().ToUpper() : "U") : "U";
                        }
                        @if (!string.IsNullOrEmpty(userAvatar))
                        {
                            <img src="@userAvatar" alt="User Avatar" class="avatar-image">
                        }
                        else
                        {
                            <div class="avatar-placeholder">@userInitials</div>
                        }
                        <span class="material-symbols-outlined">expand_more</span>
                    </div>
                    <div class="profile-dropdown" id="profile-dropdown">
                        <div class="dropdown-header">
                            <div class="user-info">
                                @if (!string.IsNullOrEmpty(userAvatar))
                                {
                                    <img src="@userAvatar" alt="User Avatar" class="avatar-image">
                                }
                                else
                                {
                                    <div class="avatar-placeholder">@userInitials</div>
                                }
                                <div>
                                    <h4>@(User.Identity?.Name ?? "User")</h4>
                                    <p>@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Instructor") ? "Instructor" : "Student")</p>
                                </div>
                            </div>
                        </div>
                        <div class="dropdown-links">
                            <a href="@Url.Action("Index", "Profile")" class="dropdown-link">
                                <span class="material-symbols-outlined">person</span>
                                Profile
                            </a>
                            @if (!User.IsInRole("Admin") && !User.IsInRole("Instructor"))
                            {
                                <a href="@Url.Action("Index", "UserDashboard")" class="dropdown-link">
                                    <span class="material-symbols-outlined">dashboard</span>
                                    Dashboard
                                </a>
                                <a href="@Url.Action("Index", "MyCourses")" class="dropdown-link">
                                    <span class="material-symbols-outlined">school</span>
                                    My Courses
                                </a>
                                <a href="@Url.Action("Index", "Enroll")" class="dropdown-link">
                                    <span class="material-symbols-outlined">add_circle</span>
                                    Enroll
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <form asp-action="Logout" asp-controller="Account" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-link logout-btn">
                                    <span class="material-symbols-outlined">logout</span>
                                    Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Guest User Buttons (when not logged in) -->
                <div class="nav-buttons" id="guest-buttons">
                    <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
                    <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
                </div>
            }
            
            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" id="mobile-menu-toggle">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </nav>

    <!-- Mobile Navigation Menu -->
    <div class="mobile-nav-menu" id="mobile-nav-menu">
        <div class="mobile-nav-header">
            <img src="~/assets/images/luIZ_without_bg.png" alt="LuIZ Learning">
            <button class="close-mobile-menu" onclick="closeMobileMenu()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <ul class="mobile-nav-links">
            <li><a href="@Url.Action("Index", "OurCourses")" class="mobile-nav-link">Courses</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="@Url.Action("Index", "AdminPanel")" class="mobile-nav-link">Admin Panel</a></li>
                }
                else if (User.IsInRole("Instructor"))
                {
                    <li><a href="@Url.Action("Index", "InstructorDashboard")" class="mobile-nav-link">Instructor Dashboard</a></li>
                }
                else
                {
                    <!-- Student/Company role navigation -->
                    <li><a href="@Url.Action("Index", "CareerSimulator")" class="mobile-nav-link">Career Simulator</a></li>
                    <li><a href="@Url.Action("Index", "QuizCenter")" class="mobile-nav-link">Quiz Center</a></li>
                    <li><a href="@Url.Action("Index", "Leaderboard")" class="mobile-nav-link">Leaderboard</a></li>
                }
            }
            else
            {
                <!-- Guest user navigation -->
                <li><a href="@Url.Action("Index", "CareerSimulator")" class="mobile-nav-link">Career Simulator</a></li>
                <li><a href="@Url.Action("Index", "QuizCenter")" class="mobile-nav-link">Quiz Center</a></li>
                <li><a href="@Url.Action("Index", "Leaderboard")" class="mobile-nav-link">Leaderboard</a></li>
            }
            
            <li><a href="@Url.Action("Index", "Contact")" class="mobile-nav-link">Contact</a></li>
        </ul>
        
        <!-- Mobile Search Bar -->
        <div class="mobile-search-bar">
            <form action="@Url.Action("Index", "OurCourses")" method="get">
                <div>
                    <input type="text" name="searchTerm" placeholder="Search for courses..." class="mobile-search-input">
                    <button type="submit" class="mobile-search-submit-btn">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </form>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mobile-nav-actions">
                <a href="@Url.Action("Index", "Profile")" class="mobile-nav-link">Profile</a>
                @if (!User.IsInRole("Admin") && !User.IsInRole("Instructor"))
                {
                    <a href="@Url.Action("Index", "UserDashboard")" class="mobile-nav-link">Dashboard</a>
                    <a href="@Url.Action("Index", "MyCourses")" class="mobile-nav-link">My Courses</a>
                }
                <form asp-action="Logout" asp-controller="Account" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mobile-nav-link logout-btn">Logout</button>
                </form>
            </div>
        }
        else
        {
            <div class="mobile-nav-actions">
                <a href="@Url.Action("Login", "Account")" class="mobile-nav-link">Log In</a>
                <a href="@Url.Action("Signup", "Account")" class="mobile-nav-link">Sign Up</a>
            </div>
        }
    </div>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <!-- Footer removed as requested -->
    </footer>

    <!-- Chatbot Floating Button -->
    <div class="chatbot-container" id="chatbot-container">
        <div class="chatbot-button" id="chatbot-button">
            <span class="material-symbols-outlined">chat</span>
        </div>

        <!-- Chat Interface -->
        <div class="chat-interface" id="chat-interface">
            <div class="chat-header">
                <h3>LuIZ Learning Assistant</h3>
                <button class="close-chat" id="close-chat">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="chat-messages" id="chat-messages">
                <div class="message bot-message">
                    <div class="message-avatar">AI</div>
                    <div class="message-content">
                        <p>Hello! I'm your learning assistant. How can I help you today?</p>
                    </div>
                </div>
            </div>

            <div class="chat-input-area">
                <div class="chat-input-wrapper">
                    <input type="text" id="chat-input" placeholder="Type your message..." maxlength="500">
                    <button class="send-button" id="send-button">
                        <span class="material-symbols-outlined">send</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
