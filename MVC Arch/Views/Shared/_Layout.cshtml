<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCV_Capstone</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MCV_Capstone.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header Navigation -->
    <nav id="header-nav">
        <div class="nav-left">
            <img src="~/assets/images/luIZ_without_bg.png" alt="LuIZ Learning" onclick="window.location.href='@Url.Action("Index", "Home")'" style="cursor: pointer;">
        </div>
        
        <div class="nav-center">
            <ul class="nav-menu">
                <li><a href="@Url.Action("Index", "CoursePreview")" class="nav-link">Courses</a></li>
                <li><a href="@Url.Action("Index", "CareerSimulator")" class="nav-link">Career Simulator</a></li>
                <li><a href="@Url.Action("Index", "QuizCenter")" class="nav-link">Quiz Center</a></li>
                <li><a href="@Url.Action("Index", "Leaderboard")" class="nav-link">Leaderboard</a></li>
                <li><a href="@Url.Action("Index", "Contact")" class="nav-link">Contact</a></li>
            </ul>
        </div>
        
        <div class="nav-right">
            <form id="search-bar">
                <div>
                    <input type="text" placeholder="Search for courses..." class="search-input">
                    <span class="material-symbols-outlined">search</span>
                </div>
            </form>
            
            <!-- User Profile Section (when logged in) -->
            <div class="user-profile-section" id="user-profile-section" style="display: none;">
                <div class="user-avatar" onclick="toggleProfileDropdown()">
                    <div class="avatar-placeholder">JD</div>
                    <span class="material-symbols-outlined">expand_more</span>
                </div>
                <div class="profile-dropdown" id="profile-dropdown">
                    <div class="dropdown-header">
                        <div class="user-info">
                            <div class="avatar-placeholder">JD</div>
                            <div>
                                <h4>John Doe</h4>
                                <p>Student</p>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown-links">
                        <a href="@Url.Action("Index", "Profile")" class="dropdown-link">
                            <span class="material-symbols-outlined">person</span>
                            Profile
                        </a>
                        <a href="@Url.Action("Index", "UserDashboard")" class="dropdown-link">
                            <span class="material-symbols-outlined">dashboard</span>
                            Dashboard
                        </a>
                        <a href="@Url.Action("Index", "MyCourses")" class="dropdown-link">
                            <span class="material-symbols-outlined">school</span>
                            My Courses
                        </a>
                        <a href="@Url.Action("Index", "Enroll")" class="dropdown-link">
                            <span class="material-symbols-outlined">add_circle</span>
                            Enroll
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="@Url.Action("Login", "Account")" class="dropdown-link">
                            <span class="material-symbols-outlined">logout</span>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Guest User Buttons (when not logged in) -->
            <div class="nav-buttons" id="guest-buttons">
                <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
                <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
            </div>
            
            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" id="mobile-menu-toggle">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </nav>

    <!-- Mobile Navigation Menu -->
    <div class="mobile-nav-menu" id="mobile-nav-menu">
        <div class="mobile-nav-header">
            <img src="~/assets/images/luIZ_without_bg.png" alt="LuIZ Learning">
            <button class="close-mobile-menu" onclick="closeMobileMenu()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <ul class="mobile-nav-links">
            <li><a href="@Url.Action("Index", "CoursePreview")" class="mobile-nav-link">Courses</a></li>
            <li><a href="@Url.Action("Index", "CareerSimulator")" class="mobile-nav-link">Career Simulator</a></li>
            <li><a href="@Url.Action("Index", "QuizCenter")" class="mobile-nav-link">Quiz Center</a></li>
            <li><a href="@Url.Action("Index", "Leaderboard")" class="mobile-nav-link">Leaderboard</a></li>
            <li><a href="@Url.Action("Index", "Contact")" class="mobile-nav-link">Contact</a></li>
        </ul>
        <div class="mobile-nav-actions">
            <a href="@Url.Action("Index", "Profile")" class="mobile-nav-link">Profile</a>
            <a href="@Url.Action("Index", "UserDashboard")" class="mobile-nav-link">Dashboard</a>
            <a href="@Url.Action("Index", "MyCourses")" class="mobile-nav-link">My Courses</a>
        </div>
    </div>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <!-- Footer removed as requested -->
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
