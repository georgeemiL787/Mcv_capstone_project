@{
    ViewData["Title"] = "Course Approval - Admin Panel";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-gavel me-2 text-warning"></i>Course Approval Panel
                </h2>
                <div class="badge bg-info fs-6">
                    <i class="fas fa-info-circle me-1"></i>Review and approve instructor courses
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Pending Courses Section -->
            <div class="card shadow mb-4">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-clock me-2"></i>Pending Approval
                        <span class="badge bg-dark ms-2">@ViewBag.PendingCourses.Count</span>
                    </h4>
                </div>
                <div class="card-body">
                    @if (!ViewBag.PendingCourses.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5 class="text-success">No courses pending approval</h5>
                            <p class="text-muted">All published courses have been reviewed.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var course in ViewBag.PendingCourses)
                            {
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100 border-warning">
                                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                        {
                                            <img src="@course.ThumbnailUrl" class="card-img-top" alt="@course.Title" style="height: 200px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                <i class="fas fa-image fa-3x text-muted"></i>
                                            </div>
                                        }
                                        
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-warning">Pending Review</span>
                                                <span class="badge bg-info">@course.Difficulty</span>
                                            </div>
                                            
                                            <h5 class="card-title">@course.Title</h5>
                                            <p class="card-text text-muted">
                                                @(string.IsNullOrEmpty(course.ShortDescription) ? course.Description.Substring(0, Math.Min(100, course.Description.Length)) + "..." : course.ShortDescription)
                                            </p>
                                            
                                            <div class="mt-auto">
                                                <div class="row text-muted small mb-3">
                                                    <div class="col-6">
                                                        <i class="fas fa-clock me-1"></i>@course.Duration min
                                                    </div>
                                                    <div class="col-6">
                                                        <i class="fas fa-tag me-1"></i>@course.Category
                                                    </div>
                                                </div>
                                                
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <div>
                                                        @if (course.DiscountedPrice.HasValue && course.DiscountedPrice < course.Price)
                                                        {
                                                            <span class="text-decoration-line-through text-muted">$@course.Price</span>
                                                            <span class="fw-bold text-success ms-2">$@course.DiscountedPrice</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold">$@course.Price</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted">
                                                        <i class="fas fa-user me-1"></i>@course.Instructor.FirstName @course.Instructor.LastName
                                                    </small>
                                                </div>
                                                
                                                <div class="d-flex gap-2">
                                                    <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-info btn-sm flex-fill">
                                                        <i class="fas fa-eye me-1"></i>Review
                                                    </a>
                                                    <button class="btn btn-success btn-sm flex-fill" onclick="approveCourse(@course.Id)">
                                                        <i class="fas fa-check me-1"></i>Approve
                                                    </button>
                                                    <button class="btn btn-danger btn-sm flex-fill" onclick="rejectCourse(@course.Id)">
                                                        <i class="fas fa-times me-1"></i>Reject
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="card-footer bg-transparent">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar me-1"></i>Published: @course.PublishedAt?.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recently Approved Courses Section -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-check-circle me-2"></i>Recently Approved
                        <span class="badge bg-light text-dark ms-2">@ViewBag.ApprovedCourses.Count</span>
                    </h4>
                </div>
                <div class="card-body">
                    @if (!ViewBag.ApprovedCourses.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No approved courses yet</h5>
                            <p class="text-muted">Approved courses will appear here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Course</th>
                                        <th>Instructor</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Approved</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in ViewBag.ApprovedCourses)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                                    {
                                                        <img src="@course.ThumbnailUrl" alt="@course.Title" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                    <div>
                                                        <h6 class="mb-0">@course.Title</h6>
                                                        <small class="text-muted">@course.Difficulty</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@course.Instructor.FirstName @course.Instructor.LastName</td>
                                            <td><span class="badge bg-secondary">@course.Category</span></td>
                                            <td>
                                                @if (course.DiscountedPrice.HasValue && course.DiscountedPrice < course.Price)
                                                {
                                                    <span class="text-decoration-line-through text-muted">$@course.Price</span>
                                                    <span class="fw-bold text-success ms-2">$@course.DiscountedPrice</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold">$@course.Price</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @course.ApprovedAt?.ToString("MMM dd, yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-times me-2"></i>Reject Course
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectionForm" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label fw-bold">Rejection Reason *</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason" rows="4" 
                                  placeholder="Please provide a clear reason for rejecting this course..." required></textarea>
                        <small class="form-text text-muted">This reason will be shared with the instructor.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-2"></i>Reject Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentCourseId = null;

        function approveCourse(courseId) {
            if (confirm('Are you sure you want to approve this course? It will become visible to all students.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Approve", "CourseApproval")';
                
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const csrfInput = document.createElement('input');
                csrfInput.type = 'hidden';
                csrfInput.name = '__RequestVerificationToken';
                csrfInput.value = csrfToken;
                
                const courseIdInput = document.createElement('input');
                courseIdInput.type = 'hidden';
                courseIdInput.name = 'id';
                courseIdInput.value = courseId;
                
                form.appendChild(csrfInput);
                form.appendChild(courseIdInput);
                document.body.appendChild(form);
                form.submit();
            }
        }

        function rejectCourse(courseId) {
            currentCourseId = courseId;
            const modal = new bootstrap.Modal(document.getElementById('rejectionModal'));
            modal.show();
        }

        document.getElementById('rejectionForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Reject", "CourseApproval")';
            
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '__RequestVerificationToken';
            csrfInput.value = csrfToken;
            
            const courseIdInput = document.createElement('input');
            courseIdInput.type = 'hidden';
            courseIdInput.name = 'id';
            courseIdInput.value = currentCourseId;
            
            const reasonInput = document.createElement('input');
            reasonInput.type = 'hidden';
            reasonInput.name = 'rejectionReason';
            reasonInput.value = document.getElementById('rejectionReason').value;
            
            form.appendChild(csrfInput);
            form.appendChild(courseIdInput);
            form.appendChild(reasonInput);
            document.body.appendChild(form);
            form.submit();
        });

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
