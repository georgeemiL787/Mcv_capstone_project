@model MCV_Capstone.Services.AdminDashboardStats
@{
    ViewData["Title"] = "Admin Panel - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/admin-users.css">
    <link rel="stylesheet" href="~/css/admin-courses.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search,menu" />
}

<div class="admin-layout">
    <!-- Left Sidebar -->
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.User?.ProfilePhoto))
            {
                <img src="data:image/jpeg;base64,@ViewBag.User.ProfilePhoto" alt="Profile Photo" class="avatar-image">
            }
            else
            {
                <div class="avatar-placeholder">
                    @(ViewBag.User?.FirstName?.Length > 0 ? ViewBag.User.FirstName[0].ToString().ToUpper() : "A")
                    @(ViewBag.User?.LastName?.Length > 0 ? ViewBag.User.LastName[0].ToString().ToUpper() : "D")
                </div>
            }
            </div>
            <h3>Admin Dashboard</h3>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="#dashboard" class="nav-item active" data-section="dashboard">
                <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="nav-icon">
                Dashboard
            </a>
            <a href="/AdminPanel/Users" class="nav-item" data-section="users">
                <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="nav-icon">
                Manage Users
            </a>
            <a href="#courses" class="nav-item" data-section="courses">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="nav-icon">
                Course Management
            </a>
            <a href="#content" class="nav-item" data-section="content">
                <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="nav-icon">
                Content Moderation
            </a>
            <a href="#analytics" class="nav-item" data-section="analytics">
                <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="nav-icon">
                Analytics
            </a>
            <a href="#ai-tools" class="nav-item" data-section="ai-tools">
                <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="nav-icon">
                AI Tools
            </a>
            <a href="#revenue" class="nav-item" data-section="revenue">
                <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="nav-icon">
                Revenue Reports
            </a>
            <a href="#settings" class="nav-item" data-section="settings">
                <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="nav-icon">
                Admin Settings
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="admin-main">
        <!-- Dashboard Section -->
        <div id="dashboard" class="content-section active">
            <div class="admin-header">
                <h1 class="admin-title">Dashboard</h1>
                <p class="admin-subtitle">Overview of platform performance and key metrics.</p>
            </div>

            <div class="dashboard-grid">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">Total Users</h3>
                        <div class="card-icon users">
                            <img src="~/assets/images/AdminPanel_assets/management.png" alt="Users" style="width: 20px; height: 20px;">
                        </div>
                    </div>
                    <div class="card-value" id="total-users">@Model.TotalUsers.ToString("N0")</div>
                    <div class="card-change positive">+12% this month</div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">Active Courses</h3>
                        <div class="card-icon courses">
                            <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Courses" style="width: 20px; height: 20px;">
                        </div>
                    </div>
                    <div class="card-value" id="total-courses">@Model.TotalCourses.ToString("N0")</div>
                    <div class="card-change positive">+8% this month</div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">Revenue</h3>
                        <div class="card-icon revenue">
                            <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue" style="width: 20px; height: 20px;">
                        </div>
                    </div>
                    <div class="card-value" id="total-revenue">$@Model.TotalRevenue.ToString("N0")</div>
                    <div class="card-change positive">+15% this month</div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">Pending Reviews</h3>
                        <div class="card-icon pending">
                            <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Reviews" style="width: 20px; height: 20px;">
                        </div>
                    </div>
                    <div class="card-value" id="pending-courses">@Model.PendingCourses.ToString("N0")</div>
                    <div class="card-change negative">+5 today</div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="activity-feed">
                <h3>Recent Activity</h3>
                <div id="recent-activity-list">
                    @foreach (var activity in Model.RecentActivity.Take(5))
                    {
                        <div class="activity-item">
                            <div class="activity-icon @(activity.Icon == "user" ? "user" : "course")">
                                <img src="~/assets/images/AdminPanel_assets/@(activity.Icon == "user" ? "management.png" : "Course Management.png")" alt="@activity.Type" style="width: 16px; height: 16px;">
                            </div>
                            <div class="activity-content">
                                <div class="activity-description">@activity.Description</div>
                                <div class="activity-time">@GetTimeAgo(activity.Timestamp)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Courses Section -->
        <div id="courses" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">Course Management</h1>
                <p class="admin-subtitle">Review, approve, and manage course submissions.</p>
            </div>

            <div class="filters-section">
                <div class="search-box">
                    <input type="text" id="course-search" placeholder="Search courses...">
                    <button type="button" id="search-btn">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
                <div class="filter-controls">
                    <select id="category-filter">
                        <option value="">All Categories</option>
                        <option value="Programming">Programming</option>
                        <option value="Design">Design</option>
                        <option value="Business">Business</option>
                        <option value="Marketing">Marketing</option>
                    </select>
                    <button class="btn btn-secondary" id="refresh-courses">
                        <span class="material-symbols-outlined">refresh</span>
                        Refresh
                    </button>
                </div>
            </div>

            <div class="courses-grid" id="courses-grid">
                <!-- Courses will be loaded here dynamically -->
            </div>
        </div>

        <!-- Content Moderation Section -->
        <div id="content" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">Content Moderation</h1>
                <p class="admin-subtitle">Review and moderate platform content for quality and safety.</p>
            </div>

            <div class="filters-section">
                <div class="status-tabs">
                    <button class="status-tab active">All Content</button>
                    <button class="status-tab">Flagged</button>
                    <button class="status-tab">Under Review</button>
                    <button class="status-tab">Approved</button>
                </div>
                <button class="btn btn-secondary" id="refresh-content">
                    <span class="material-symbols-outlined">refresh</span>
                    Refresh
                </button>
            </div>

            <div class="content-list" id="content-list">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>

        <!-- Analytics Section -->
        <div id="analytics" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">Analytics</h1>
                <p class="admin-subtitle">Platform performance metrics and user behavior insights.</p>
            </div>

            <div class="analytics-grid" id="analytics-grid">
                <!-- Analytics will be loaded here dynamically -->
            </div>
        </div>

        <!-- AI Tools Section -->
        <div id="ai-tools" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">AI Tools</h1>
                <p class="admin-subtitle">AI-powered platform tools and automation features.</p>
            </div>

            <div class="ai-tools-grid">
                <div class="ai-tool-card">
                    <h3>Content Moderation AI</h3>
                    <p>Automated content filtering and moderation</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn btn-secondary">Configure</button>
                    </div>
                </div>
                <div class="ai-tool-card">
                    <h3>Recommendation Engine</h3>
                    <p>AI-powered course recommendations</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn btn-secondary">Configure</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Section -->
        <div id="revenue" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">Revenue Reports</h1>
                <p class="admin-subtitle">Financial reports and revenue analytics.</p>
            </div>

            <div class="revenue-summary" id="revenue-summary">
                <!-- Revenue data will be loaded here dynamically -->
            </div>
        </div>

        <!-- Settings Section -->
        <div id="settings" class="content-section">
            <div class="admin-header">
                <h1 class="admin-title">Admin Settings</h1>
                <p class="admin-subtitle">Platform configuration and administrative settings.</p>
            </div>

            <div class="settings-form">
                <div class="form-group">
                    <label>Platform Name</label>
                    <input type="text" value="LuIZ Learning Platform" class="setting-input" id="platform-name">
                </div>
                <div class="form-group">
                    <label>Maintenance Mode</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="maintenance-mode">
                        <label for="maintenance-mode"></label>
                    </div>
                </div>
                <div class="form-group">
                    <label>Email Notifications</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="email-notifications" checked>
                        <label for="email-notifications"></label>
                    </div>
                </div>
                <button class="btn btn-primary" id="save-settings">Save Settings</button>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="reject-course-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Reject Course</h3>
            <span class="close-btn" onclick="closeModal('reject-course-modal')">&times;</span>
        </div>
        <div class="modal-body">
            <p>Please provide a reason for rejecting this course:</p>
            <textarea id="rejection-reason" placeholder="Enter rejection reason..."></textarea>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('reject-course-modal')">Cancel</button>
            <button class="btn btn-danger" id="confirm-reject">Reject Course</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}

@functions {
    public string GetTimeAgo(DateTime timestamp)
    {
        var timeSpan = DateTime.UtcNow - timestamp;
        
        if (timeSpan.TotalDays > 1)
            return $"{(int)timeSpan.TotalDays} days ago";
        else if (timeSpan.TotalDays == 1)
            return "1 day ago";
        else if (timeSpan.TotalHours > 1)
            return $"{(int)timeSpan.TotalHours} hours ago";
        else if (timeSpan.TotalHours == 1)
            return "1 hour ago";
        else if (timeSpan.TotalMinutes > 1)
            return $"{(int)timeSpan.TotalMinutes} minutes ago";
        else if (timeSpan.TotalMinutes == 1)
            return "1 minute ago";
        else
            return "Just now";
    }
} 