@{
    ViewData["Title"] = "Admin Panel - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search,menu" />
}

<nav id="header-nav">
    <div class="nav-right">
        <img src="~/assets/images/luIZ_without_bg.png">
        <button class="nav-button">Explore</button>
        <form id="search-bar">
            <div>
                <input type="text" placeholder="Search for courses..." class="search-input">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
    </div>
    <div class="nav-buttons">
        <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
        <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
    </div>
</nav>

<div class="admin-layout">
    <!-- Left Sidebar -->
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">AD</div>
            </div>
            <h3>Admin Dashboard</h3>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="#dashboard" class="nav-item active" data-section="dashboard">
                <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="nav-icon">
                Dashboard
            </a>
            <a href="#users" class="nav-item" data-section="users">
                <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="nav-icon">
                Manage Users
            </a>
            <a href="#courses" class="nav-item" data-section="courses">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="nav-icon">
                Course Management
            </a>
            <a href="#content" class="nav-item" data-section="content">
                <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="nav-icon">
                Content Moderation
            </a>
            <a href="#analytics" class="nav-item" data-section="analytics">
                <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="nav-icon">
                Analytics
            </a>
            <a href="#ai-tools" class="nav-item" data-section="ai-tools">
                <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="nav-icon">
                AI Tools
            </a>
            <a href="#revenue" class="nav-item" data-section="revenue">
                <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="nav-icon">
                Revenue Reports
            </a>
            <a href="#settings" class="nav-item" data-section="settings">
                <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="nav-icon">
                Settings
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="admin-content">
        <!-- Dashboard Section -->
        <div id="dashboard" class="content-section active">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="header-image">
                    <div>
                        <h1>Dashboard</h1>
                        <p>Overview of platform performance and key metrics.</p>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/management.png" alt="Users" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Total Users</h3>
                        <p class="stat-number">15,247</p>
                        <span class="stat-change positive">+12% from last month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Courses" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Active Courses</h3>
                        <p class="stat-number">342</p>
                        <span class="stat-change positive">+8% from last month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Monthly Revenue</h3>
                        <p class="stat-number">$45,892</p>
                        <span class="stat-change positive">+15% from last month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Completion Rate" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Completion Rate</h3>
                        <p class="stat-number">78%</p>
                        <span class="stat-change positive">+5% from last month</span>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="recent-activity">
                <h2>Recent Activity</h2>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/management.png" alt="User" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>New User Registration</h4>
                            <p>Sarah Johnson registered as a student</p>
                            <span class="activity-time">2 minutes ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>Course Published</h4>
                            <p>"Advanced React Development" was published by John Doe</p>
                            <span class="activity-time">15 minutes ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>Payment Received</h4>
                            <p>Premium subscription payment from user ID #1247</p>
                            <span class="activity-time">1 hour ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Other sections would be loaded dynamically -->
        <div id="users" class="content-section">
            <div class="content-header">
                <h1>Manage Users</h1>
                <p>User management and administration tools.</p>
            </div>
            <!-- Users content would go here -->
        </div>

        <div id="courses" class="content-section">
            <div class="content-header">
                <h1>Course Management</h1>
                <p>Manage and moderate course content.</p>
            </div>
            <!-- Courses content would go here -->
        </div>

        <div id="content" class="content-section">
            <div class="content-header">
                <h1>Content Moderation</h1>
                <p>Review and moderate platform content.</p>
            </div>
            <!-- Content moderation content would go here -->
        </div>

        <div id="analytics" class="content-section">
            <div class="content-header">
                <h1>Analytics</h1>
                <p>Platform analytics and insights.</p>
            </div>
            <!-- Analytics content would go here -->
        </div>

        <div id="ai-tools" class="content-section">
            <div class="content-header">
                <h1>AI Tools</h1>
                <p>AI-powered platform tools and features.</p>
            </div>
            <!-- AI tools content would go here -->
        </div>

        <div id="revenue" class="content-section">
            <div class="content-header">
                <h1>Revenue Reports</h1>
                <p>Financial reports and revenue analytics.</p>
            </div>
            <!-- Revenue content would go here -->
        </div>

        <div id="settings" class="content-section">
            <div class="content-header">
                <h1>Admin Settings</h1>
                <p>Platform configuration and settings.</p>
            </div>
            <!-- Settings content would go here -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
} 