@{
    ViewData["Title"] = "Admin Panel - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search,menu" />
}

<div class="admin-layout">
    <!-- Left Sidebar -->
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">AD</div>
            </div>
            <h3>Admin Dashboard</h3>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="#dashboard" class="nav-item active" data-section="dashboard">
                <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="nav-icon">
                Dashboard
            </a>
            <a href="#users" class="nav-item" data-section="users">
                <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="nav-icon">
                Manage Users
            </a>
            <a href="#courses" class="nav-item" data-section="courses">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="nav-icon">
                Course Management
            </a>
            <a href="#content" class="nav-item" data-section="content">
                <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="nav-icon">
                Content Moderation
            </a>
            <a href="#analytics" class="nav-item" data-section="analytics">
                <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="nav-icon">
                Analytics
            </a>
            <a href="#ai-tools" class="nav-item" data-section="ai-tools">
                <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="nav-icon">
                AI Tools
            </a>
            <a href="#revenue" class="nav-item" data-section="revenue">
                <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="nav-icon">
                Revenue Reports
            </a>
            <a href="#settings" class="nav-item" data-section="settings">
                <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="nav-icon">
                Settings
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="admin-content">
        <!-- Dashboard Section -->
        <div id="dashboard" class="content-section active">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="header-image">
                    <div>
                        <h1>Dashboard</h1>
                        <p>Overview of platform performance and key metrics.</p>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/management.png" alt="Users" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Total Users</h3>
                        <p class="stat-number">12,847</p>
                        <span class="stat-change positive">+12% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/computer.png" alt="Courses" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Active Courses</h3>
                        <p class="stat-number">1,234</p>
                        <span class="stat-change positive">+8% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Revenue</h3>
                        <p class="stat-number">$45,678</p>
                        <span class="stat-change positive">+15% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Reviews" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Pending Reviews</h3>
                        <p class="stat-number">23</p>
                        <span class="stat-change negative">+5 today</span>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="recent-activity">
                <h2>Recent Activity</h2>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/management.png" alt="User Registration" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>New user registered</h4>
                            <p>John Doe joined the platform</p>
                            <span class="activity-time">2 minutes ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/computer.png" alt="Course Published" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>Course published</h4>
                            <p>"Advanced React Development" by Sarah Smith</p>
                            <span class="activity-time">15 minutes ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon">
                            <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Flagged" class="activity-image">
                        </div>
                        <div class="activity-content">
                            <h4>Content flagged</h4>
                            <p>Comment flagged for inappropriate content</p>
                            <span class="activity-time">1 hour ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Section -->
        <div id="users" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="header-image">
                    <div>
                        <h1>Manage Users</h1>
                        <p>View and manage user accounts, permissions, and status.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="search-box">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" placeholder="Search users...">
                </div>
                <button class="action-btn">
                    <img src="~/assets/images/AdminPanel_assets/add-user.png" alt="Add User" class="action-icon">
                    Add User
                </button>
            </div>

            <div class="users-table">
                <div class="table-header">
                    <span>User</span>
                    <span>Email</span>
                    <span>Role</span>
                    <span>Status</span>
                    <span>Actions</span>
                </div>
                <div class="table-row">
                    <div class="user-info">
                        <div class="user-avatar">JD</div>
                        <div>
                            <h4>John Doe</h4>
                            <span>Joined 2 days ago</span>
                        </div>
                    </div>
                    <span>john.doe@email.com</span>
                    <span class="role-badge student">Student</span>
                    <span class="status-badge active">Active</span>
                    <div class="action-buttons">
                        <button class="btn-small">View</button>
                        <button class="btn-small warning">Ban</button>
                    </div>
                </div>
                <div class="table-row">
                    <div class="user-info">
                        <div class="user-avatar">SS</div>
                        <div>
                            <h4>Sarah Smith</h4>
                            <span>Joined 1 week ago</span>
                        </div>
                    </div>
                    <span>sarah.smith@email.com</span>
                    <span class="role-badge instructor">Instructor</span>
                    <span class="status-badge active">Active</span>
                    <div class="action-buttons">
                        <button class="btn-small">View</button>
                        <button class="btn-small warning">Ban</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Courses Section -->
        <div id="courses" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="header-image">
                    <div>
                        <h1>Course Management</h1>
                        <p>Approve, reject, and manage course submissions.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="filter-tabs">
                    <button class="filter-tab active">All Courses</button>
                    <button class="filter-tab">Pending Review</button>
                    <button class="filter-tab">Approved</button>
                    <button class="filter-tab">Rejected</button>
                </div>
            </div>

            <div class="courses-grid">
                <div class="course-card">
                    <div class="course-header">
                        <h3>Advanced React Development</h3>
                        <span class="status-badge pending">Pending</span>
                    </div>
                    <p>Learn advanced React concepts including hooks, context, and performance optimization.</p>
                    <div class="course-meta">
                        <span>By: Sarah Smith</span>
                        <span>Duration: 12 hours</span>
                    </div>
                    <div class="course-actions">
                        <button class="btn-success">Approve</button>
                        <button class="btn-danger">Reject</button>
                        <button class="btn-secondary">Preview</button>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-header">
                        <h3>Python for Data Science</h3>
                        <span class="status-badge approved">Approved</span>
                    </div>
                    <p>Comprehensive guide to using Python for data analysis and machine learning.</p>
                    <div class="course-meta">
                        <span>By: Mike Johnson</span>
                        <span>Duration: 18 hours</span>
                    </div>
                    <div class="course-actions">
                        <button class="btn-secondary">View</button>
                        <button class="btn-warning">Unpublish</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Moderation Section -->
        <div id="content" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="header-image">
                    <div>
                        <h1>Content Moderation</h1>
                        <p>Review and moderate platform content for quality and safety.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="filter-tabs">
                    <button class="filter-tab active">All Content</button>
                    <button class="filter-tab">Flagged</button>
                    <button class="filter-tab">Under Review</button>
                    <button class="filter-tab">Approved</button>
                </div>
            </div>

            <div class="content-list">
                <div class="content-item">
                    <div class="content-info">
                        <h4>Comment on "React Basics"</h4>
                        <p>This course helped me understand React so much better!</p>
                        <span class="content-meta">By: User123 • 1 hour ago</span>
                    </div>
                    <div class="content-actions">
                        <button class="btn-success">Approve</button>
                        <button class="btn-danger">Remove</button>
                        <button class="btn-warning">Flag</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Analytics Section -->
        <div id="analytics" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="header-image">
                    <div>
                        <h1>Analytics</h1>
                        <p>Platform performance metrics and user behavior insights.</p>
                    </div>
                </div>
            </div>

            <div class="analytics-grid">
                <div class="analytics-card">
                    <h3>User Growth</h3>
                    <div class="chart-placeholder">
                        <span>Chart visualization would go here</span>
                    </div>
                </div>
                <div class="analytics-card">
                    <h3>Course Performance</h3>
                    <div class="chart-placeholder">
                        <span>Chart visualization would go here</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Tools Section -->
        <div id="ai-tools" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="header-image">
                    <div>
                        <h1>AI Tools</h1>
                        <p>AI-powered platform tools and automation features.</p>
                    </div>
                </div>
            </div>

            <div class="ai-tools-grid">
                <div class="ai-tool-card">
                    <h3>Content Moderation AI</h3>
                    <p>Automated content filtering and moderation</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn-secondary">Configure</button>
                    </div>
                </div>
                <div class="ai-tool-card">
                    <h3>Recommendation Engine</h3>
                    <p>AI-powered course recommendations</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn-secondary">Configure</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Section -->
        <div id="revenue" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="header-image">
                    <div>
                        <h1>Revenue Reports</h1>
                        <p>Financial reports and revenue analytics.</p>
                    </div>
                </div>
            </div>

            <div class="revenue-summary">
                <div class="revenue-card">
                    <h3>Monthly Revenue</h3>
                    <p class="revenue-amount">$45,678</p>
                    <span class="revenue-change positive">+15% from last month</span>
                </div>
                <div class="revenue-card">
                    <h3>Total Subscriptions</h3>
                    <p class="revenue-amount">2,847</p>
                    <span class="revenue-change positive">+8% from last month</span>
                </div>
            </div>
        </div>

        <!-- Settings Section -->
        <div id="settings" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="header-image">
                    <div>
                        <h1>Admin Settings</h1>
                        <p>Platform configuration and administrative settings.</p>
                    </div>
                </div>
            </div>

            <div class="settings-form">
                <div class="setting-group">
                    <label>Platform Name</label>
                    <input type="text" value="LuIZ Learning Platform" class="setting-input">
                </div>
                <div class="setting-group">
                    <label>Maintenance Mode</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="maintenance-mode">
                        <label for="maintenance-mode"></label>
                    </div>
                </div>
                <div class="setting-group">
                    <label>Email Notifications</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="email-notifications" checked>
                        <label for="email-notifications"></label>
                    </div>
                </div>
                <button class="btn-primary">Save Settings</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
} 