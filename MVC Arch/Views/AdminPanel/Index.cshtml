@model MCV_Capstone.Services.AdminDashboardStats
@{
    ViewData["Title"] = "Admin Panel - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search,menu" />
}

<div class="admin-layout">
    <!-- Left Sidebar -->
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                <div class="avatar-placeholder">AD</div>
            </div>
            <h3>Admin Dashboard</h3>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="#dashboard" class="nav-item active" data-section="dashboard">
                <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="nav-icon">
                Dashboard
            </a>
            <a href="#users" class="nav-item" data-section="users">
                <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="nav-icon">
                Manage Users
            </a>
            <a href="#courses" class="nav-item" data-section="courses">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="nav-icon">
                Course Management
            </a>
            <a href="#content" class="nav-item" data-section="content">
                <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="nav-icon">
                Content Moderation
            </a>
            <a href="#analytics" class="nav-item" data-section="analytics">
                <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="nav-icon">
                Analytics
            </a>
            <a href="#ai-tools" class="nav-item" data-section="ai-tools">
                <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="nav-icon">
                AI Tools
            </a>
            <a href="#revenue" class="nav-item" data-section="revenue">
                <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="nav-icon">
                Revenue Reports
            </a>
            <a href="#settings" class="nav-item" data-section="settings">
                <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="nav-icon">
                Settings
            </a>
        </nav>
    </div>

    <!-- Right Content Area -->
    <div class="admin-content">
        <!-- Dashboard Section -->
        <div id="dashboard" class="content-section active">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/dashboard.png" alt="Dashboard" class="header-image">
                    <div>
                        <h1>Dashboard</h1>
                        <p>Overview of platform performance and key metrics.</p>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/management.png" alt="Users" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Total Users</h3>
                        <p class="stat-number" id="total-users">@Model.TotalUsers.ToString("N0")</p>
                        <span class="stat-change positive">+12% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/computer.png" alt="Courses" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Active Courses</h3>
                        <p class="stat-number" id="total-courses">@Model.TotalCourses.ToString("N0")</p>
                        <span class="stat-change positive">+8% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Revenue</h3>
                        <p class="stat-number" id="total-revenue">$@Model.TotalRevenue.ToString("N0")</p>
                        <span class="stat-change positive">+15% this month</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Reviews" class="stat-image">
                    </div>
                    <div class="stat-info">
                        <h3>Pending Reviews</h3>
                        <p class="stat-number" id="pending-courses">@Model.PendingCourses.ToString("N0")</p>
                        <span class="stat-change negative">+5 today</span>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="recent-activity">
                <h2>Recent Activity</h2>
                <div class="activity-list" id="recent-activity-list">
                    @foreach (var activity in Model.RecentActivity.Take(5))
                    {
                        <div class="activity-item">
                            <div class="activity-icon">
                                <img src="~/assets/images/AdminPanel_assets/@(activity.Icon == "user" ? "management.png" : "computer.png")" alt="@activity.Type" class="activity-image">
                            </div>
                            <div class="activity-content">
                                <h4>@activity.Type</h4>
                                <p>@activity.Description</p>
                                <span class="activity-time">@GetTimeAgo(activity.Timestamp)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Users Section -->
        <div id="users" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/management.png" alt="Manage Users" class="header-image">
                    <div>
                        <h1>Manage Users</h1>
                        <p>View and manage user accounts, permissions, and status.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="search-box">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" id="user-search" placeholder="Search users...">
                </div>
                <div class="filter-controls">
                    <select id="role-filter">
                        <option value="">All Roles</option>
                        <option value="Student">Student</option>
                        <option value="Instructor">Instructor</option>
                        <option value="Company">Company</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <select id="status-filter">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Banned">Banned</option>
                    </select>
                </div>
                <button class="action-btn" id="refresh-users">
                    <img src="~/assets/images/AdminPanel_assets/refresh.png" alt="Refresh" class="action-icon">
                    Refresh
                </button>
            </div>

            <div class="users-table" id="users-table">
                <div class="table-header">
                    <span>User</span>
                    <span>Email</span>
                    <span>Role</span>
                    <span>Status</span>
                    <span>Actions</span>
                </div>
                <div id="users-table-body">
                    <!-- Users will be loaded here dynamically -->
                </div>
            </div>
        </div>

        <!-- Courses Section -->
        <div id="courses" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Course Management" class="header-image">
                    <div>
                        <h1>Course Management</h1>
                        <p>Approve, reject, and manage course submissions.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="filter-tabs">
                    <button class="filter-tab active" data-filter="all">All Courses</button>
                    <button class="filter-tab" data-filter="pending">Pending Review</button>
                    <button class="filter-tab" data-filter="approved">Approved</button>
                    <button class="filter-tab" data-filter="rejected">Rejected</button>
                </div>
                <button class="action-btn" id="refresh-courses">
                    <img src="~/assets/images/AdminPanel_assets/refresh.png" alt="Refresh" class="action-icon">
                    Refresh
                </button>
            </div>

            <div class="courses-grid" id="courses-grid">
                <!-- Courses will be loaded here dynamically -->
            </div>
        </div>

        <!-- Content Moderation Section -->
        <div id="content" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/moderator.png" alt="Content Moderation" class="header-image">
                    <div>
                        <h1>Content Moderation</h1>
                        <p>Review and moderate platform content for quality and safety.</p>
                    </div>
                </div>
            </div>

            <div class="section-actions">
                <div class="filter-tabs">
                    <button class="filter-tab active">All Content</button>
                    <button class="filter-tab">Flagged</button>
                    <button class="filter-tab">Under Review</button>
                    <button class="filter-tab">Approved</button>
                </div>
                <button class="action-btn" id="refresh-content">
                    <img src="~/assets/images/AdminPanel_assets/refresh.png" alt="Refresh" class="action-icon">
                    Refresh
                </button>
            </div>

            <div class="content-list" id="content-list">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>

        <!-- Analytics Section -->
        <div id="analytics" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/analytics.png" alt="Analytics" class="header-image">
                    <div>
                        <h1>Analytics</h1>
                        <p>Platform performance metrics and user behavior insights.</p>
                    </div>
                </div>
            </div>

            <div class="analytics-grid" id="analytics-grid">
                <!-- Analytics will be loaded here dynamically -->
            </div>
        </div>

        <!-- AI Tools Section -->
        <div id="ai-tools" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/management(1).png" alt="AI Tools" class="header-image">
                    <div>
                        <h1>AI Tools</h1>
                        <p>AI-powered platform tools and automation features.</p>
                    </div>
                </div>
            </div>

            <div class="ai-tools-grid">
                <div class="ai-tool-card">
                    <h3>Content Moderation AI</h3>
                    <p>Automated content filtering and moderation</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn-secondary">Configure</button>
                    </div>
                </div>
                <div class="ai-tool-card">
                    <h3>Recommendation Engine</h3>
                    <p>AI-powered course recommendations</p>
                    <div class="tool-status">
                        <span class="status-badge active">Active</span>
                        <button class="btn-secondary">Configure</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Section -->
        <div id="revenue" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/revenue.png" alt="Revenue Reports" class="header-image">
                    <div>
                        <h1>Revenue Reports</h1>
                        <p>Financial reports and revenue analytics.</p>
                    </div>
                </div>
            </div>

            <div class="revenue-summary" id="revenue-summary">
                <!-- Revenue data will be loaded here dynamically -->
            </div>
        </div>

        <!-- Settings Section -->
        <div id="settings" class="content-section">
            <div class="content-header">
                <div class="header-with-image">
                    <img src="~/assets/images/AdminPanel_assets/user.png" alt="Admin Settings" class="header-image">
                    <div>
                        <h1>Admin Settings</h1>
                        <p>Platform configuration and administrative settings.</p>
                    </div>
                </div>
            </div>

            <div class="settings-form">
                <div class="setting-group">
                    <label>Platform Name</label>
                    <input type="text" value="LuIZ Learning Platform" class="setting-input" id="platform-name">
                </div>
                <div class="setting-group">
                    <label>Maintenance Mode</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="maintenance-mode">
                        <label for="maintenance-mode"></label>
                    </div>
                </div>
                <div class="setting-group">
                    <label>Email Notifications</label>
                    <div class="toggle-switch">
                        <input type="checkbox" id="email-notifications" checked>
                        <label for="email-notifications"></label>
                    </div>
                </div>
                <button class="btn-primary" id="save-settings">Save Settings</button>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="reject-course-modal" class="modal">
    <div class="modal-content">
        <h3>Reject Course</h3>
        <p>Please provide a reason for rejecting this course:</p>
        <textarea id="rejection-reason" placeholder="Enter rejection reason..."></textarea>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('reject-course-modal')">Cancel</button>
            <button class="btn-danger" id="confirm-reject">Reject Course</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}

@functions {
    public string GetTimeAgo(DateTime timestamp)
    {
        var timeSpan = DateTime.UtcNow - timestamp;
        
        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minutes ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hours ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} days ago";
        
        return timestamp.ToString("MMM dd, yyyy");
    }
} 