@model MCV_Capstone.ViewModels.AdminUserManagementViewModel
@{
    ViewData["Title"] = "User Management - Admin Panel";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/admin-users.css">
}

<div class="admin-users-container">
    <div class="page-header">
        <h1>User Management</h1>
        <p>Manage user accounts, permissions, and status</p>
    </div>

    <!-- Search and Filters -->
    <div class="filters-section">
        <div class="search-box">
            <input type="text" id="user-search" placeholder="Search users by name or email..." value="@Model.SearchTerm">
            <button type="button" id="search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <div class="filter-controls">
            <select id="role-filter">
                <option value="">All Roles</option>
                <option value="Student" selected="@(Model.RoleFilter == "Student")">Student</option>
                <option value="Instructor" selected="@(Model.RoleFilter == "Instructor")">Instructor</option>
                <option value="Company" selected="@(Model.RoleFilter == "Company")">Company</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
            </select>

            <select id="status-filter">
                <option value="">All Status</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                <option value="Banned" selected="@(Model.StatusFilter == "Banned")">Banned</option>
            </select>

            <button type="button" id="refresh-btn" class="btn-secondary">
                <i class="fas fa-refresh"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Users Table -->
    <div class="users-table-container">
        <table class="users-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Registration Date</th>
                    <th>Last Login</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="users-table-body">
                <!-- Users will be loaded here dynamically -->
            </tbody>
        </table>

        <!-- Loading indicator -->
        <div id="loading-indicator" class="loading-indicator" style="display: none;">
            <div class="spinner"></div>
            <p>Loading users...</p>
        </div>

        <!-- No users message -->
        <div id="no-users-message" class="no-data-message" style="display: none;">
            <p>No users found matching your criteria.</p>
        </div>
    </div>

    <!-- Pagination -->
    <div class="pagination-container" id="pagination-container" style="display: none;">
        <div class="pagination-info">
            <span id="pagination-info"></span>
        </div>
        <div class="pagination-controls">
            <button id="prev-page" class="btn-secondary" disabled>Previous</button>
            <div class="page-numbers" id="page-numbers"></div>
            <button id="next-page" class="btn-secondary">Next</button>
        </div>
    </div>
</div>

<!-- Ban User Modal -->
<div id="ban-user-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Ban User</h3>
            <button class="close-btn" onclick="closeModal('ban-user-modal')">&times;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to ban this user? They will not be able to log in or access the platform.</p>
            <div class="form-group">
                <label for="ban-reason">Reason for ban:</label>
                <textarea id="ban-reason" placeholder="Please provide a reason for banning this user..." required></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('ban-user-modal')">Cancel</button>
            <button type="button" class="btn-danger" id="confirm-ban">Ban User</button>
        </div>
    </div>
</div>

<!-- Unban User Modal -->
<div id="unban-user-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Unban User</h3>
            <button class="close-btn" onclick="closeModal('unban-user-modal')">&times;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to unban this user? They will be able to log in and access the platform again.</p>
            <div class="form-group">
                <label for="unban-reason">Reason for unban (optional):</label>
                <textarea id="unban-reason" placeholder="Please provide a reason for unbanning this user..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('unban-user-modal')">Cancel</button>
            <button type="button" class="btn-primary" id="confirm-unban">Unban User</button>
        </div>
    </div>
</div>

<!-- User Details Modal -->
<div id="user-details-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>User Details</h3>
            <button class="close-btn" onclick="closeModal('user-details-modal')">&times;</button>
        </div>
        <div class="modal-body" id="user-details-content">
            <!-- User details will be loaded here -->
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('user-details-modal')">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-users.js"></script>
}
