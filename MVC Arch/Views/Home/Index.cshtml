@{
    ViewData["Title"] = "Home - Full Courses Platform";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
    <link rel="stylesheet" href="~/css/home.css" />
}

<nav id="header-nav">
    <div class="nav-right">
        <img src="~/assets/images/luIZ_without_bg.png" alt="Logo">
        <button class="nav-button">Explore</button>
        <form id="search-bar">
            <div>
                <input type="text" placeholder="Search for courses..." class="search-input">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
    </div>
    <div class="nav-buttons">
        <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
        <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
    </div>
</nav>

<div class="welcome">
    <h1>Welcome to Full Courses Platform</h1>
    <p>Discover trending courses and boost your skills with AI-powered recommendations.</p>
    <button class="cta-btn">Get Started</button>
</div>
