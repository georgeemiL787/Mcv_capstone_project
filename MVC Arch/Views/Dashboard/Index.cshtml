@{
    ViewData["Title"] = "Dashboard - Learning Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
}



<!-- Dashboard Layout -->
<div class="dashboard-layout">
    <!-- Left Sidebar -->
    <div class="dashboard-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.User?.ProfilePhoto))
                {
                    <img src="data:image/jpeg;base64,@ViewBag.User.ProfilePhoto" alt="Profile Photo" class="avatar-image">
                }
                else
                {
                    <div class="avatar-placeholder">
                        @(ViewBag.User?.FirstName?.Length > 0 ? ViewBag.User.FirstName[0].ToString().ToUpper() : "U")
                        @(ViewBag.User?.LastName?.Length > 0 ? ViewBag.User.LastName[0].ToString().ToUpper() : "")
                    </div>
                }
            </div>
            <h3>@(ViewBag.User?.FirstName ?? "User") @(ViewBag.User?.LastName ?? "")</h3>
            <p>@(ViewBag.User?.Headline ?? "Student")</p>
        </div>
        
        <div class="sidebar-nav">
            <a href="#overview" class="nav-item active" data-section="overview">
                <span class="material-symbols-outlined">dashboard</span>
                Overview
            </a>
            <a href="#roadmap" class="nav-item" data-section="roadmap">
                <span class="material-symbols-outlined">timeline</span>
                Skill Roadmap
            </a>
            <a href="#progress" class="nav-item" data-section="progress">
                <span class="material-symbols-outlined">trending_up</span>
                Progress Tracker
            </a>
            <a href="#courses" class="nav-item" data-section="courses">
                <span class="material-symbols-outlined">school</span>
                My Courses
            </a>
            <a href="#insights" class="nav-item" data-section="insights">
                <span class="material-symbols-outlined">psychology</span>
                Smart Insights
            </a>
            <a href="#achievements" class="nav-item" data-section="achievements">
                <span class="material-symbols-outlined">emoji_events</span>
                Achievements
            </a>
            <a href="#reminders" class="nav-item" data-section="reminders">
                <span class="material-symbols-outlined">notifications</span>
                Reminders
            </a>
        </div>
    </div>

    <!-- Right Content Area -->
    <div class="dashboard-content">
        <!-- Overview Section -->
        <div id="overview" class="content-section active">
            <div class="content-header">
                <h1>Dashboard Overview</h1>
                <p>Track your learning journey and stay motivated with personalized insights.</p>
            </div>

            <!-- XP and Level Progress -->
            <div class="xp-section">
                <div class="level-card">
                    <div class="level-info">
                        <h3>Level 12</h3>
                        <p>Software Developer</p>
                    </div>
                    <div class="xp-progress">
                        <div class="xp-bar">
                            <div class="xp-fill" style="width: 75%"></div>
                        </div>
                        <p>2,450 / 3,200 XP</p>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <span class="material-symbols-outlined">school</span>
                    </div>
                    <div class="stat-content">
                        <h3>8</h3>
                        <p>Active Courses</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <span class="material-symbols-outlined">schedule</span>
                    </div>
                    <div class="stat-content">
                        <h3>24h</h3>
                        <p>Study Time</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <span class="material-symbols-outlined">emoji_events</span>
                    </div>
                    <div class="stat-content">
                        <h3>15</h3>
                        <p>Achievements</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <span class="material-symbols-outlined">trending_up</span>
                    </div>
                    <div class="stat-content">
                        <h3>85%</h3>
                        <p>Completion Rate</p>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="activity-section">
                <h2>Recent Activity</h2>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon">
                            <span class="material-symbols-outlined">play_circle</span>
                        </div>
                        <div class="activity-content">
                            <h4>Completed JavaScript Basics</h4>
                            <p>Finished module 3 of Web Development course</p>
                            <span class="activity-time">2 hours ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon">
                            <span class="material-symbols-outlined">quiz</span>
                        </div>
                        <div class="activity-content">
                            <h4>Quiz Completed</h4>
                            <p>Scored 90% on React Fundamentals quiz</p>
                            <span class="activity-time">1 day ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon">
                            <span class="material-symbols-outlined">emoji_events</span>
                        </div>
                        <div class="activity-content">
                            <h4>New Achievement Unlocked</h4>
                            <p>Earned "Quick Learner" badge</p>
                            <span class="activity-time">2 days ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Skill Roadmap Section -->
        <div id="roadmap" class="content-section">
            <div class="content-header">
                <h1>Skill Roadmap</h1>
                <p>Visualize your learning path and track your progress through different skill levels.</p>
            </div>

            <div class="roadmap-container">
                <div class="roadmap-path">
                    <div class="skill-node completed">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">check_circle</span>
                        </div>
                        <div class="node-content">
                            <h3>HTML & CSS</h3>
                            <p>Completed</p>
                        </div>
                    </div>
                    <div class="skill-node completed">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">check_circle</span>
                        </div>
                        <div class="node-content">
                            <h3>JavaScript</h3>
                            <p>Completed</p>
                        </div>
                    </div>
                    <div class="skill-node active">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">play_circle</span>
                        </div>
                        <div class="node-content">
                            <h3>React.js</h3>
                            <p>In Progress</p>
                        </div>
                    </div>
                    <div class="skill-node">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <div class="node-content">
                            <h3>Node.js</h3>
                            <p>Locked</p>
                        </div>
                    </div>
                    <div class="skill-node">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <div class="node-content">
                            <h3>Database Design</h3>
                            <p>Locked</p>
                        </div>
                    </div>
                    <div class="skill-node">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <div class="node-content">
                            <h3>API Development</h3>
                            <p>Locked</p>
                        </div>
                    </div>
                    <div class="skill-node">
                        <div class="node-icon">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <div class="node-content">
                            <h3>DevOps & Deployment</h3>
                            <p>Locked</p>
                        </div>
                    </div>
                </div>
                
                <div class="roadmap-stats">
                    <div class="roadmap-stat">
                        <h4>Skills Completed</h4>
                        <span class="stat-number">2</span>
                    </div>
                    <div class="roadmap-stat">
                        <h4>Skills In Progress</h4>
                        <span class="stat-number">1</span>
                    </div>
                    <div class="roadmap-stat">
                        <h4>Skills Remaining</h4>
                        <span class="stat-number">4</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Tracker Section -->
        <div id="progress" class="content-section">
            <div class="content-header">
                <h1>Progress Tracker</h1>
                <p>Monitor your learning progress across all courses and skills.</p>
            </div>

            <div class="progress-overview">
                <div class="progress-card">
                    <h3>Overall Progress</h3>
                    <div class="progress-circle">
                        <div class="circle-progress" data-progress="68">
                            <span class="progress-text">68%</span>
                        </div>
                    </div>
                    <p>You're doing great! Keep up the momentum.</p>
                </div>
            </div>

            <div class="progress-stats">
                <div class="progress-stat">
                    <h4>Total Courses</h4>
                    <span class="stat-number">12</span>
                </div>
                <div class="progress-stat">
                    <h4>Completed</h4>
                    <span class="stat-number">8</span>
                </div>
                <div class="progress-stat">
                    <h4>In Progress</h4>
                    <span class="stat-number">3</span>
                </div>
                <div class="progress-stat">
                    <h4>Not Started</h4>
                    <span class="stat-number">1</span>
                </div>
            </div>

            <div class="course-progress">
                <h2>Course Progress</h2>
                <div class="progress-list">
                    <div class="progress-item">
                        <div class="course-info">
                            <h4>React Fundamentals</h4>
                            <p>12 of 15 modules completed</p>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 80%"></div>
                        </div>
                        <span class="progress-percentage">80%</span>
                    </div>
                    <div class="progress-item">
                        <div class="course-info">
                            <h4>Advanced JavaScript</h4>
                            <p>8 of 12 modules completed</p>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 67%"></div>
                        </div>
                        <span class="progress-percentage">67%</span>
                    </div>
                    <div class="progress-item">
                        <div class="course-info">
                            <h4>CSS Grid & Flexbox</h4>
                            <p>15 of 15 modules completed</p>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 100%"></div>
                        </div>
                        <span class="progress-percentage">100%</span>
                    </div>
                    <div class="progress-item">
                        <div class="course-info">
                            <h4>Node.js Backend</h4>
                            <p>3 of 10 modules completed</p>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 30%"></div>
                        </div>
                        <span class="progress-percentage">30%</span>
                    </div>
                    <div class="progress-item">
                        <div class="course-info">
                            <h4>Database Design</h4>
                            <p>0 of 8 modules completed</p>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 0%"></div>
                        </div>
                        <span class="progress-percentage">0%</span>
                    </div>
                </div>
            </div>

            <div class="learning-streak">
                <h2>Learning Streak</h2>
                <div class="streak-calendar">
                    <div class="streak-header">
                        <span class="material-symbols-outlined">local_fire_department</span>
                        <h3>Current Streak: 7 days</h3>
                    </div>
                    <div class="calendar-grid">
                        <div class="calendar-day completed">1</div>
                        <div class="calendar-day completed">2</div>
                        <div class="calendar-day completed">3</div>
                        <div class="calendar-day completed">4</div>
                        <div class="calendar-day completed">5</div>
                        <div class="calendar-day completed">6</div>
                        <div class="calendar-day completed">7</div>
                        <div class="calendar-day">8</div>
                        <div class="calendar-day">9</div>
                        <div class="calendar-day">10</div>
                        <div class="calendar-day">11</div>
                        <div class="calendar-day">12</div>
                        <div class="calendar-day">13</div>
                        <div class="calendar-day">14</div>
                        <div class="calendar-day">15</div>
                        <div class="calendar-day">16</div>
                        <div class="calendar-day">17</div>
                        <div class="calendar-day">18</div>
                        <div class="calendar-day">19</div>
                        <div class="calendar-day">20</div>
                        <div class="calendar-day">21</div>
                        <div class="calendar-day">22</div>
                        <div class="calendar-day">23</div>
                        <div class="calendar-day">24</div>
                        <div class="calendar-day">25</div>
                        <div class="calendar-day">26</div>
                        <div class="calendar-day">27</div>
                        <div class="calendar-day">28</div>
                        <div class="calendar-day">29</div>
                        <div class="calendar-day">30</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My Courses Section -->
        <div id="courses" class="content-section">
            <div class="content-header">
                <h1>My Courses</h1>
                <p>Continue your learning journey with these recommended courses.</p>
            </div>

            <div class="courses-filter">
                <button class="filter-btn active" data-filter="all">All Courses</button>
                <button class="filter-btn" data-filter="in-progress">In Progress</button>
                <button class="filter-btn" data-filter="completed">Completed</button>
                <button class="filter-btn" data-filter="not-started">Not Started</button>
            </div>

            <div class="courses-grid">
                <div class="course-card" data-status="in-progress">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">code</span>
                    </div>
                    <div class="course-info">
                        <h3>React Fundamentals</h3>
                        <p>Learn the basics of React.js</p>
                        <div class="course-meta">
                            <span>80% Complete</span>
                            <span>2 modules left</span>
                        </div>
                    </div>
                    <button class="continue-btn">Continue</button>
                </div>
                <div class="course-card" data-status="in-progress">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">javascript</span>
                    </div>
                    <div class="course-info">
                        <h3>Advanced JavaScript</h3>
                        <p>Master advanced JS concepts</p>
                        <div class="course-meta">
                            <span>67% Complete</span>
                            <span>4 modules left</span>
                        </div>
                    </div>
                    <button class="continue-btn">Continue</button>
                </div>
                <div class="course-card" data-status="completed">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">web</span>
                    </div>
                    <div class="course-info">
                        <h3>CSS Grid & Flexbox</h3>
                        <p>Modern CSS layouts</p>
                        <div class="course-meta">
                            <span>100% Complete</span>
                            <span>Certificate earned</span>
                        </div>
                    </div>
                    <button class="certificate-btn">View Certificate</button>
                </div>
                <div class="course-card" data-status="in-progress">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">storage</span>
                    </div>
                    <div class="course-info">
                        <h3>Node.js Backend</h3>
                        <p>Build server-side applications</p>
                        <div class="course-meta">
                            <span>30% Complete</span>
                            <span>7 modules left</span>
                        </div>
                    </div>
                    <button class="continue-btn">Continue</button>
                </div>
                <div class="course-card" data-status="not-started">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">database</span>
                    </div>
                    <div class="course-info">
                        <h3>Database Design</h3>
                        <p>Learn SQL and database concepts</p>
                        <div class="course-meta">
                            <span>0% Complete</span>
                            <span>8 modules</span>
                        </div>
                    </div>
                    <button class="start-btn">Start Course</button>
                </div>
                <div class="course-card" data-status="not-started">
                    <div class="course-thumbnail">
                        <span class="material-symbols-outlined">api</span>
                    </div>
                    <div class="course-info">
                        <h3>API Development</h3>
                        <p>Build RESTful APIs</p>
