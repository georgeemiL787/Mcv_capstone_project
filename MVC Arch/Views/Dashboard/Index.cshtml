                </div>
            </div>

            <div class="course-recommendations">
                <h2>Recommended for You</h2>
                <div class="recommendations-grid">
                    <div class="recommendation-card">
                        <div class="rec-thumbnail">
                            <span class="material-symbols-outlined">psychology</span>
                        </div>
                        <div class="rec-content">
                            <h4>Machine Learning Basics</h4>
                            <p>Based on your interest in algorithms</p>
                            <button class="enroll-btn">Enroll Now</button>
                        </div>
                    </div>
                    <div class="recommendation-card">
                        <div class="rec-thumbnail">
                            <span class="material-symbols-outlined">security</span>
                        </div>
                        <div class="rec-content">
                            <h4>Web Security</h4>
                            <p>Essential for full-stack developers</p>
                            <button class="enroll-btn">Enroll Now</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Smart Insights Section -->
        <div id="insights" class="content-section">
            <div class="content-header">
                <h1>Smart Insights</h1>
                <p>AI-powered analysis of your learning patterns and recommendations.</p>
            </div>

            <div class="insights-overview">
                <div class="insight-summary">
                    <div class="summary-icon">
                        <span class="material-symbols-outlined">psychology</span>
                    </div>
                    <div class="summary-content">
                        <h3>Learning Score: 8.5/10</h3>
                        <p>You're performing above average! Your consistent study habits and problem-solving approach are key strengths.</p>
                    </div>
                </div>
            </div>

            <div class="insights-grid">
                <div class="insight-card">
                    <div class="insight-header">
                        <span class="material-symbols-outlined">trending_up</span>
                        <h3>Strengths</h3>
                    </div>
                    <div class="insight-content">
                        <ul>
                            <li>Excellent problem-solving skills</li>
                            <li>Strong grasp of JavaScript fundamentals</li>
                            <li>Consistent study habits</li>
                            <li>Quick learner in frontend technologies</li>
                            <li>Good time management</li>
                        </ul>
                    </div>
                </div>
                <div class="insight-card">
                    <div class="insight-header">
                        <span class="material-symbols-outlined">trending_down</span>
                        <h3>Areas to Improve</h3>
                    </div>
                    <div class="insight-content">
                        <ul>
                            <li>Need more practice with React Hooks</li>
                            <li>Database concepts need review</li>
                            <li>Consider more advanced algorithms</li>
                            <li>Backend development skills</li>
                            <li>Testing and debugging techniques</li>
                        </ul>
                    </div>
                </div>
                <div class="insight-card">
                    <div class="insight-header">
                        <span class="material-symbols-outlined">lightbulb</span>
                        <h3>Recommendations</h3>
                    </div>
                    <div class="insight-content">
                        <ul>
                            <li>Focus on React State Management</li>
                            <li>Practice with real-world projects</li>
                            <li>Join coding challenges</li>
                            <li>Start learning Node.js</li>
                            <li>Build a portfolio project</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="learning-patterns">
                <h2>Learning Patterns</h2>
                <div class="patterns-grid">
                    <div class="pattern-card">
                        <div class="pattern-icon">
                            <span class="material-symbols-outlined">schedule</span>
                        </div>
                        <div class="pattern-info">
                            <h4>Best Study Time</h4>
                            <p>Evenings (7-10 PM)</p>
                            <span class="pattern-score">95% productivity</span>
                        </div>
                    </div>
                    <div class="pattern-card">
                        <div class="pattern-icon">
                            <span class="material-symbols-outlined">timer</span>
                        </div>
                        <div class="pattern-info">
                            <h4>Optimal Session Length</h4>
                            <p>45-60 minutes</p>
                            <span class="pattern-score">88% retention</span>
                        </div>
                    </div>
                    <div class="pattern-card">
                        <div class="pattern-icon">
                            <span class="material-symbols-outlined">psychology</span>
                        </div>
                        <div class="pattern-info">
                            <h4>Learning Style</h4>
                            <p>Visual + Hands-on</p>
                            <span class="pattern-score">92% effectiveness</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ai-recommendations">
                <h2>AI-Powered Recommendations</h2>
                <div class="ai-grid">
                    <div class="ai-card">
                        <div class="ai-header">
                            <span class="material-symbols-outlined">auto_awesome</span>
                            <h4>Next Best Course</h4>
                        </div>
                        <p>Complete React Fundamentals before moving to Node.js Backend</p>
                        <button class="ai-action-btn">View Course</button>
                    </div>
                    <div class="ai-card">
                        <div class="ai-header">
                            <span class="material-symbols-outlined">target</span>
                            <h4>Skill Gap Analysis</h4>
                        </div>
                        <p>Focus on database concepts to become full-stack ready</p>
                        <button class="ai-action-btn">Learn More</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Achievements Section -->
        <div id="achievements" class="content-section">
            <div class="content-header">
                <h1>Achievements</h1>
                <p>Celebrate your learning milestones and accomplishments.</p>
            </div>

            <div class="achievements-overview">
                <div class="achievement-stats">
                    <div class="achievement-stat">
                        <h4>Total Achievements</h4>
                        <span class="stat-number">12</span>
                    </div>
                    <div class="achievement-stat">
                        <h4>Earned</h4>
                        <span class="stat-number">8</span>
                    </div>
                    <div class="achievement-stat">
                        <h4>Locked</h4>
                        <span class="stat-number">4</span>
                    </div>
                    <div class="achievement-stat">
                        <h4>Completion Rate</h4>
