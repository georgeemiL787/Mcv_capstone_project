                    </div>
                </div>
            </div>

            <div class="achievements-grid">
                <div class="achievement-card earned">
                    <div class="achievement-icon">
                        <span class="material-symbols-outlined">emoji_events</span>
                    </div>
                    <h3>First Steps</h3>
                    <p>Complete your first course</p>
                    <span class="achievement-date">Earned 2 weeks ago</span>
                </div>
                <div class="achievement-card earned">
                    <div class="achievement-icon">
                        <span class="material-symbols-outlined">local_fire_department</span>
                    </div>
                    <h3>Streak Master</h3>
                    <p>Study for 7 consecutive days</p>
                    <span class="achievement-date">Earned 1 week ago</span>
                </div>
                <div class="achievement-card earned">
                    <div class="achievement-icon">
                        <span class="material-symbols-outlined">workspace_premium</span>
                    </div>
                    <h3>Certificate Collector</h3>
                    <p>Earn 5 certificates</p>
                    <span class="achievement-date">Earned 3 days ago</span>
                </div>
                <div class="achievement-card earned">
                    <div class="achievement-icon">
                        <span class="material-symbols-outlined">speed</span>
                    </div>
