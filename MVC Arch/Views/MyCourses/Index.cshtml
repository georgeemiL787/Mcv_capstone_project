@{
    ViewData["Title"] = "My Courses - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/my-courses.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<nav id="header-nav">
    <div class="nav-right">
        <img src="~/assets/images/luIZ_without_bg.png">
        <button class="nav-button">Explore</button>
        <form id="search-bar">
            <div>
                <input type="text" placeholder="Search for courses..." class="search-input">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
    </div>
    <div class="nav-buttons">
        <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
        <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
    </div>
</nav>

<div class="my-courses-layout">
    <!-- Header Section -->
    <div class="courses-header">
        <div class="header-content">
            <h1>My Courses</h1>
            <p>Track your learning progress and manage your enrolled courses.</p>
        </div>
        
        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">All Courses</button>
            <button class="filter-tab" data-filter="in-progress">In Progress</button>
            <button class="filter-tab" data-filter="completed">Completed</button>
            <button class="filter-tab" data-filter="bookmarked">Bookmarked</button>
        </div>
    </div>

    <!-- Courses Grid -->
    <div class="courses-grid">
        <!-- In Progress Course -->
        <div class="course-card in-progress" data-status="in-progress">
            <div class="course-image">
                <img src="~/assets/images/luIZ.png" alt="React Fundamentals">
                <div class="course-overlay">
                    <span class="course-status">In Progress</span>
                </div>
            </div>
            
            <div class="course-content">
                <h3>React Fundamentals</h3>
                <p class="course-description">Learn the basics of React and build your first components.</p>
                
                <div class="course-progress">
                    <div class="progress-info">
                        <span>Progress</span>
                        <span>75%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 75%"></div>
                    </div>
                </div>
                
                <div class="course-meta">
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        12 lessons remaining
                    </span>
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Last accessed 2 days ago
                    </span>
                </div>
                
                <div class="course-actions">
                    <a href="@Url.Action("Index", "CoursePreview")" class="continue-btn">Continue Learning</a>
                    <button class="bookmark-btn">
                        <span class="material-symbols-outlined">bookmark</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Completed Course -->
        <div class="course-card completed" data-status="completed">
            <div class="course-image">
                <img src="~/assets/images/luIZ.png" alt="JavaScript Basics">
                <div class="course-overlay">
                    <span class="course-status">Completed</span>
                </div>
            </div>
            
            <div class="course-content">
                <h3>JavaScript Basics</h3>
                <p class="course-description">Master JavaScript fundamentals and ES6+ features.</p>
                
                <div class="course-progress">
                    <div class="progress-info">
                        <span>Progress</span>
                        <span>100%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 100%"></div>
                    </div>
                </div>
                
                <div class="course-meta">
                    <span class="meta-item">
                        <span class="material-symbols-outlined">verified</span>
                        Certificate earned
                    </span>
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Completed 1 week ago
                    </span>
                </div>
                
                <div class="course-actions">
                    <a href="#" class="certificate-btn">View Certificate</a>
                    <button class="rate-btn">
                        <span class="material-symbols-outlined">star</span>
                        Rate Course
                    </button>
                </div>
            </div>
        </div>

        <!-- In Progress Course -->
        <div class="course-card in-progress" data-status="in-progress">
            <div class="course-image">
                <img src="~/assets/images/luIZ.png" alt="CSS Advanced">
                <div class="course-overlay">
                    <span class="course-status">In Progress</span>
                </div>
            </div>
            
            <div class="course-content">
                <h3>CSS Advanced Techniques</h3>
                <p class="course-description">Master advanced CSS including Flexbox, Grid, and animations.</p>
                
                <div class="course-progress">
                    <div class="progress-info">
                        <span>Progress</span>
                        <span>45%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 45%"></div>
                    </div>
                </div>
                
                <div class="course-meta">
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        18 lessons remaining
                    </span>
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Last accessed today
                    </span>
                </div>
                
                <div class="course-actions">
                    <a href="@Url.Action("Index", "CoursePreview")" class="continue-btn">Continue Learning</a>
                    <button class="bookmark-btn active">
                        <span class="material-symbols-outlined">bookmark</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Completed Course -->
        <div class="course-card completed" data-status="completed">
            <div class="course-image">
                <img src="~/assets/images/luIZ.png" alt="HTML Fundamentals">
                <div class="course-overlay">
                    <span class="course-status">Completed</span>
                </div>
            </div>
            
            <div class="course-content">
                <h3>HTML Fundamentals</h3>
                <p class="course-description">Learn HTML5 structure, semantics, and best practices.</p>
                
                <div class="course-progress">
                    <div class="progress-info">
                        <span>Progress</span>
                        <span>100%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 100%"></div>
                    </div>
                </div>
                
                <div class="course-meta">
                    <span class="meta-item">
                        <span class="material-symbols-outlined">verified</span>
                        Certificate earned
                    </span>
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Completed 2 weeks ago
                    </span>
                </div>
                
                <div class="course-actions">
                    <a href="#" class="certificate-btn">View Certificate</a>
                    <button class="rate-btn">
                        <span class="material-symbols-outlined">star</span>
                        Rate Course
                    </button>
                </div>
            </div>
        </div>

        <!-- In Progress Course -->
        <div class="course-card in-progress" data-status="in-progress">
            <div class="course-image">
                <img src="~/assets/images/luIZ.png" alt="Node.js Backend">
                <div class="course-overlay">
                    <span class="course-status">In Progress</span>
                </div>
            </div>
            
            <div class="course-content">
                <h3>Node.js Backend Development</h3>
                <p class="course-description">Build scalable backend applications with Node.js and Express.</p>
                
                <div class="course-progress">
                    <div class="progress-info">
                        <span>Progress</span>
                        <span>30%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 30%"></div>
                    </div>
                </div>
                
                <div class="course-meta">
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        25 lessons remaining
                    </span>
                    <span class="meta-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Last accessed 3 days ago
                    </span>
                </div>
                
                <div class="course-actions">
                    <a href="@Url.Action("Index", "CoursePreview")" class="continue-btn">Continue Learning</a>
                    <button class="bookmark-btn">
                        <span class="material-symbols-outlined">bookmark</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State (hidden by default) -->
    <div class="empty-state" style="display: none;">
        <div class="empty-icon">
            <span class="material-symbols-outlined">school</span>
        </div>
        <h2>No courses found</h2>
        <p>You haven't enrolled in any courses yet. Start your learning journey today!</p>
        <a href="@Url.Action("Index", "Home")" class="browse-btn">Browse Courses</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/my-courses.js"></script>
} 