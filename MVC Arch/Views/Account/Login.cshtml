@model MCV_Capstone.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
}



<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>Welcome Back</h2>
            <p>Sign in to continue your learning journey</p>
        </div>
        
        <form class="login-form" asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="Enter your email" required>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="Enter your password" required>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            
            <div class="form-options">
                <label class="checkbox-container">
                    <input asp-for="RememberMe" type="checkbox">
                    <span class="checkmark"></span>
                    Remember me
                </label>
                <a href="#" class="forgot-password">Forgot Password?</a>
            </div>
            
            <button type="submit" class="login-btn">Sign In</button>
        </form>
        
        <div class="instructor-login">
            <div class="instructor-divider">
                <span>Instructor Access</span>
            </div>
            <button type="button" class="instructor-btn">
                <span class="material-symbols-outlined"></span>
                Sign In As Instructor
            </button>
        </div>
        
        <div class="login-divider">
            <span>or</span>
        </div>
        
        <div class="social-login">
            <button class="social-btn google" type="button">
                <img src="~/assets/images/2.png" alt="Google" class="social-logo">
                Continue with Google
            </button>
            <button class="social-btn facebook" type="button">
                <img src="~/assets/images/facebook_logo_icon.png" alt="Facebook" class="social-logo">
                Continue with Facebook
            </button>
        </div>
        
        <div class="signup-link">
            <p>Don't have an account? <a href="@Url.Action("Signup", "Account")">Sign up</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js"></script>
}