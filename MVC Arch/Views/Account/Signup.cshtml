@{
    ViewData["Title"] = "Sign Up - Full Courses Platform";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search,school,person,business" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/signup.css" />
}



<div class="signup-container">
    <div class="signup-card">
        <div class="signup-header">
            <h2>Create Your Account</h2>
            <p>Join our learning community and start your journey</p>
        </div>
        
        <form class="signup-form" method="post" action="@Url.Action("Signup", "Account")">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" name="firstName" placeholder="Enter your first name" required>
                </div>
                
                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" name="lastName" placeholder="Enter your last name" required>
                </div>
            </div>
            
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            
            <div class="form-group">
                <label for="userType">Select Account Type</label>
                <div class="user-type-selection">
                    <label class="user-type-option">
                        <input type="radio" name="userType" value="student" required>
                        <span class="user-type-card">
                            <span class="material-symbols-outlined">school</span>
                            <span class="user-type-text">Student</span>
                        </span>
                    </label>
                    <label class="user-type-option">
                        <input type="radio" name="userType" value="instructor" required>
                        <span class="user-type-card">
                            <span class="material-symbols-outlined">person</span>
                            <span class="user-type-text">Instructor</span>
                        </span>
                    </label>
                    <label class="user-type-option">
                        <input type="radio" name="userType" value="company" required>
                        <span class="user-type-card">
                            <span class="material-symbols-outlined">business</span>
                            <span class="user-type-text">Company</span>
                        </span>
                    </label>
                </div>
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Create a password" required>
            </div>
            
            <div class="form-group">    
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required>
            </div>
            
            <div class="form-options">
                <label class="checkbox-container">
                    <input type="checkbox" name="terms" required>
                    <span class="checkmark"></span>
                    I agree to the&nbsp;<a href="#" class="terms-link">Terms of Service</a>&nbsp;and&nbsp;<a href="#" class="terms-link">Privacy Policy</a>
                </label>
            </div>
            
            <button type="submit" class="signup-btn">Create Account</button>
        </form>
        
        <div class="signup-divider">
            <span>or</span>
        </div>
        
        <div class="social-signup">
            <button class="social-btn google-btn">
                <img src="/assets/images/2.png" alt="Google" class="social-logo">
                Continue with Google
            </button>
            <button class="social-btn facebook-btn">
                <img src="/assets/images/facebook_logo_icon.png" alt="Facebook" class="social-logo">
                Continue with Facebook
            </button>
        </div>
        
        <div class="login-link">
            <p>Already have an account? <a href="@Url.Action("Login", "Account")">Sign in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signup.js"></script>
}