@{
    ViewData["Title"] = "Leaderboard - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/leaderboard.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
}

<div class="leaderboard-container">
    <!-- Header Section -->
    <div class="leaderboard-header">
        <div class="header-content">
            <h1>Course Leaderboard</h1>
            <p>See how you rank among your peers in Advanced Web Development with React</p>
            <div class="course-info">
                <span class="course-badge">
                    <span class="material-symbols-outlined">school</span>
                    React Development
                </span>
                <span class="course-stats">
                    <span class="stat-item">
                        <span class="material-symbols-outlined">group</span>
                        247 Students
                    </span>
                    <span class="stat-item">
                        <span class="material-symbols-outlined">schedule</span>
                        Week 8 of 12
                    </span>
                </span>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="leaderboard-controls">
        <div class="filter-section">
            <button class="filter-btn active" data-filter="all">All Students</button>
            <button class="filter-btn" data-filter="top">Top 10</button>
            <button class="filter-btn" data-filter="recent">Recent Activity</button>
        </div>
        <div class="search-section">
            <div class="search-input-wrapper">
                <span class="material-symbols-outlined">search</span>
                <input type="text" placeholder="Search students..." class="student-search">
            </div>
        </div>
    </div>

    <!-- Leaderboard Table -->
    <div class="leaderboard-card">
        <div class="table-header">
            <div class="rank-col">Rank</div>
            <div class="student-col">Student</div>
            <div class="progress-col">Progress</div>
            <div class="score-col">Score</div>
            <div class="activity-col">Last Activity</div>
        </div>

        <div class="leaderboard-list">
            <!-- Top 3 with special styling -->
            <div class="leaderboard-item top-3" data-rank="1">
                <div class="rank-info">
                    <div class="rank-number">1</div>
                    <div class="rank-medal">
                        <span class="material-symbols-outlined">emoji_events</span>
                    </div>
                </div>
                <div class="student-info">
                    <div class="student-avatar">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=50&h=50&fit=crop&crop=face" alt="Student">
                    </div>
                    <div class="student-details">
                        <h3>Alex Johnson</h3>
                        <span class="student-email">alex.johnson@email.com</span>
                    </div>
                </div>
                <div class="progress-section">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 95%"></div>
                    </div>
                    <span class="progress-text">95%</span>
                </div>
                <div class="score-section">
                    <div class="score-value">98.5</div>
                    <div class="score-label">points</div>
                </div>
                <div class="activity-section">
                    <span class="activity-time">2 hours ago</span>
                    <span class="activity-status online">Online</span>
                </div>
            </div>

