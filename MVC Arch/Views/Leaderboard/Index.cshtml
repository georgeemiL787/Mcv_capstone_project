@{
    ViewData["Title"] = "Leaderboard - Full Courses Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css">
    <link rel="stylesheet" href="~/css/leaderboard.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
}

<nav id="header-nav">
    <div class="nav-right">
        <img src="~/assets/images/luIZ_without_bg.png">
        <button class="nav-button">Explore</button>
        <form id="search-bar">
            <div>
                <input type="text" placeholder="Search for courses..." class="search-input">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
    </div>
    <div class="nav-buttons">
        <a href="@Url.Action("Login", "Account")" class="nav-button">Log In</a>
        <a href="@Url.Action("Signup", "Account")" class="signup nav-button">Sign Up</a>
    </div>
</nav>

<div class="leaderboard-layout">
    <!-- Header Section -->
    <div class="leaderboard-header">
        <div class="header-content">
            <h1>Leaderboard</h1>
            <p>See how you rank against other learners and track your progress.</p>
        </div>
        
        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <button class="filter-tab active" data-filter="xp">XP Ranking</button>
            <button class="filter-tab" data-filter="quiz">Quiz Scores</button>
            <button class="filter-tab" data-filter="completion">Course Completion</button>
            <button class="filter-tab" data-filter="streak">Learning Streaks</button>
        </div>
    </div>

    <!-- User Stats Card -->
    <div class="user-stats-card">
        <div class="user-info">
            <div class="user-avatar">
                <div class="avatar-placeholder">JD</div>
            </div>
            <div class="user-details">
                <h3>John Doe</h3>
                <p>Rank #15 • Level 8</p>
            </div>
        </div>
        
        <div class="user-stats">
            <div class="stat-item">
                <span class="stat-number">2,450</span>
                <span class="stat-label">Total XP</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">12</span>
                <span class="stat-label">Courses Completed</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">8</span>
                <span class="stat-label">Day Streak</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">15</span>
                <span class="stat-label">Badges Earned</span>
            </div>
        </div>
    </div>

    <!-- Top 3 Podium -->
    <div class="podium-section">
        <h2>Top Performers</h2>
        <div class="podium">
            <!-- Second Place -->
            <div class="podium-place second">
                <div class="podium-avatar">
                    <div class="avatar-placeholder">SM</div>
                </div>
                <div class="podium-info">
                    <h3>Sarah Miller</h3>
                    <p class="podium-rank">#2</p>
                    <p class="podium-xp">4,850 XP</p>
                </div>
                <div class="podium-badge">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
            </div>

            <!-- First Place -->
            <div class="podium-place first">
                <div class="podium-avatar">
                    <div class="avatar-placeholder">MJ</div>
                </div>
                <div class="podium-info">
                    <h3>Mike Johnson</h3>
                    <p class="podium-rank">#1</p>
                    <p class="podium-xp">5,200 XP</p>
                </div>
                <div class="podium-badge">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
            </div>

            <!-- Third Place -->
            <div class="podium-place third">
                <div class="podium-avatar">
                    <div class="avatar-placeholder">AL</div>
                </div>
                <div class="podium-info">
                    <h3>Anna Lee</h3>
                    <p class="podium-rank">#3</p>
                    <p class="podium-xp">4,650 XP</p>
                </div>
                <div class="podium-badge">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Leaderboard List -->
    <div class="leaderboard-list">
        <h2>Full Rankings</h2>
        <div class="rankings">
            <!-- Rank 4 -->
            <div class="ranking-item">
                <div class="rank-number">4</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">DC</div>
                    </div>
                    <div class="user-details">
                        <h3>David Chen</h3>
                        <p>Level 12 • 18 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">4,320 XP</span>
                    <div class="badges">
                        <span class="badge">Quick Learner</span>
                        <span class="badge">Perfect Score</span>
                    </div>
                </div>
            </div>

            <!-- Rank 5 -->
            <div class="ranking-item">
                <div class="rank-number">5</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">LW</div>
                    </div>
                    <div class="user-details">
                        <h3>Lisa Wang</h3>
                        <p>Level 10 • 15 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">4,150 XP</span>
                    <div class="badges">
                        <span class="badge">Consistent</span>
                        <span class="badge">Helper</span>
                    </div>
                </div>
            </div>

            <!-- Rank 6 -->
            <div class="ranking-item">
                <div class="rank-number">6</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">RK</div>
                    </div>
                    <div class="user-details">
                        <h3>Robert Kim</h3>
                        <p>Level 9 • 12 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">3,980 XP</span>
                    <div class="badges">
                        <span class="badge">Streak Master</span>
                    </div>
                </div>
            </div>

            <!-- Rank 7 -->
            <div class="ranking-item">
                <div class="rank-number">7</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">ES</div>
                    </div>
                    <div class="user-details">
                        <h3>Emma Smith</h3>
                        <p>Level 8 • 10 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">3,750 XP</span>
                    <div class="badges">
                        <span class="badge">Quiz Champion</span>
                    </div>
                </div>
            </div>

            <!-- Rank 8 -->
            <div class="ranking-item">
                <div class="rank-number">8</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">TB</div>
                    </div>
                    <div class="user-details">
                        <h3>Tom Brown</h3>
                        <p>Level 7 • 8 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">3,520 XP</span>
                    <div class="badges">
                        <span class="badge">Newcomer</span>
                    </div>
                </div>
            </div>

            <!-- Current User (Rank 15) -->
            <div class="ranking-item current-user">
                <div class="rank-number">15</div>
                <div class="user-info">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">JD</div>
                    </div>
                    <div class="user-details">
                        <h3>John Doe (You)</h3>
                        <p>Level 8 • 12 courses completed</p>
                    </div>
                </div>
                <div class="user-stats">
                    <span class="xp-amount">2,450 XP</span>
                    <div class="badges">
                        <span class="badge">Active Learner</span>
                        <span class="badge">Helper</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Badges Section -->
    <div class="badges-section">
        <h2>Recent Badges Earned</h2>
        <div class="badges-grid">
            <div class="badge-card">
                <div class="badge-icon">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
                <h3>Quick Learner</h3>
                <p>Completed 5 courses in 30 days</p>
                <span class="badge-date">Earned 2 days ago</span>
            </div>

            <div class="badge-card">
                <div class="badge-icon">
                    <span class="material-symbols-outlined">star</span>
                </div>
                <h3>Perfect Score</h3>
                <p>Scored 100% on 3 consecutive quizzes</p>
                <span class="badge-date">Earned 1 week ago</span>
            </div>

            <div class="badge-card">
                <div class="badge-icon">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>
                <h3>Streak Master</h3>
                <p>Maintained a 7-day learning streak</p>
                <span class="badge-date">Earned 2 weeks ago</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/leaderboard.js"></script>
} 