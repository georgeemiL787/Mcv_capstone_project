@{
    ViewData["Title"] = "Analytics - Instructor Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css" />
    <link rel="stylesheet" href="~/css/analytics.css" />
}

<div class="analytics-container">
    <div class="analytics-header">
        <h1>Analytics Dashboard</h1>
        <p>Comprehensive insights into your course performance and student engagement</p>
        <div class="date-range-picker">
            <label for="dateRange">Date Range:</label>
            <select id="dateRange">
                <option value="7">Last 7 days</option>
                <option value="30" selected>Last 30 days</option>
                <option value="90">Last 3 months</option>
                <option value="365">Last year</option>
            </select>
        </div>
    </div>
    
    <div class="analytics-overview">
        <div class="overview-card">
            <div class="overview-icon">
                <span class="material-symbols-outlined">trending_up</span>
            </div>
            <div class="overview-content">
                <h3>Total Revenue</h3>
                <p class="overview-value">$24,580</p>
                <span class="overview-change positive">+12.5% vs last period</span>
            </div>
        </div>
        
        <div class="overview-card">
            <div class="overview-icon">
                <span class="material-symbols-outlined">school</span>
            </div>
            <div class="overview-content">
                <h3>Total Students</h3>
                <p class="overview-value">1,247</p>
                <span class="overview-change positive">+8.7% vs last period</span>
            </div>
        </div>
        
        <div class="overview-card">
            <div class="overview-icon">
                <span class="material-symbols-outlined">course</span>
            </div>
            <div class="overview-content">
                <h3>Active Courses</h3>
                <p class="overview-value">12</p>
                <span class="overview-change neutral">No change</span>
            </div>
        </div>
        
        <div class="overview-card">
            <div class="overview-icon">
                <span class="material-symbols-outlined">star</span>
            </div>
            <div class="overview-content">
                <h3>Avg Rating</h3>
                <p class="overview-value">4.8</p>
                <span class="overview-change positive">+0.2 vs last period</span>
            </div>
        </div>
    </div>
    
    <div class="analytics-charts">
        <div class="chart-section">
            <div class="chart-header">
                <h3>Revenue Trends</h3>
                <div class="chart-controls">
                    <button class="chart-btn active" data-period="daily">Daily</button>
                    <button class="chart-btn" data-period="weekly">Weekly</button>
                    <button class="chart-btn" data-period="monthly">Monthly</button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart" width="400" height="200"></canvas>
            </div>
        </div>
        
        <div class="chart-section">
            <div class="chart-header">
                <h3>Student Engagement</h3>
                <p>Course completion rates and student activity</p>
            </div>
            <div class="chart-container">
                <canvas id="engagementChart" width="400" height="200"></canvas>
            </div>
        </div>
    </div>
    
    <div class="analytics-details">
        <div class="details-section">
            <h3>Top Performing Courses</h3>
            <div class="course-performance-list">
                <div class="course-item">
                    <div class="course-rank">1</div>
                    <div class="course-info">
                        <h4>Web Development Masterclass</h4>
                        <p>156 students • $8,450 revenue</p>
                    </div>
                    <div class="course-stats">
                        <span class="completion-rate">92% completion</span>
                        <span class="rating">4.9 ⭐</span>
                    </div>
                </div>
                
                <div class="course-item">
                    <div class="course-rank">2</div>
                    <div class="course-info">
                        <h4>Data Science Fundamentals</h4>
                        <p>124 students • $6,230 revenue</p>
                    </div>
                    <div class="course-stats">
                        <span class="completion-rate">88% completion</span>
                        <span class="rating">4.7 ⭐</span>
                    </div>
                </div>
                
                <div class="course-item">
                    <div class="course-rank">3</div>
                    <div class="course-info">
                        <h4>Digital Marketing Strategy</h4>
                        <p>98 students • $5,890 revenue</p>
                    </div>
                    <div class="course-stats">
                        <span class="completion-rate">85% completion</span>
                        <span class="rating">4.8 ⭐</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="details-section">
            <h3>Geographic Distribution</h3>
            <div class="geo-stats">
                <div class="geo-item">
                    <span class="country">United States</span>
                    <span class="percentage">45%</span>
                    <div class="geo-bar">
                        <div class="geo-fill" style="width: 45%"></div>
                    </div>
                </div>
                
                <div class="geo-item">
                    <span class="country">United Kingdom</span>
                    <span class="percentage">18%</span>
                    <div class="geo-bar">
                        <div class="geo-fill" style="width: 18%"></div>
                    </div>
                </div>
                
                <div class="geo-item">
                    <span class="country">Canada</span>
                    <span class="percentage">12%</span>
                    <div class="geo-bar">
                        <div class="geo-fill" style="width: 12%"></div>
                    </div>
                </div>
                
                <div class="geo-item">
                    <span class="country">Australia</span>
                    <span class="percentage">8%</span>
                    <div class="geo-bar">
                        <div class="geo-fill" style="width: 8%"></div>
                    </div>
                </div>
                
                <div class="geo-item">
                    <span class="country">Other</span>
                    <span class="percentage">17%</span>
                    <div class="geo-bar">
                        <div class="geo-fill" style="width: 17%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="analytics-actions">
        <button class="btn-primary">
            <span class="material-symbols-outlined">download</span>
            Export Report
        </button>
        <button class="btn-secondary">
            <span class="material-symbols-outlined">schedule</span>
            Schedule Reports
        </button>
        <button class="btn-secondary">
            <span class="material-symbols-outlined">settings</span>
            Analytics Settings
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/analytics.js"></script>
}
