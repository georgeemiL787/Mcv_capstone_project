@{
    ViewData["Title"] = "Analytics - Instructor Dashboard";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css">
    <link rel="stylesheet" href="~/css/analytics.css">
}

<div class="instructor-layout">
    <!-- Left Sidebar -->
    <div class="instructor-sidebar">
        <div class="sidebar-header">
            <div class="instructor-avatar">
                <div class="avatar-placeholder">JD</div>
            </div>
            <h3>John Doe</h3>
            <p>Instructor</p>
            <a href="#" class="view-profile-link">View Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "InstructorDashboard")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="dashboard">
                <span class="material-symbols-outlined nav-icon">dashboard</span>
                Dashboard
            </a>
            <a href="@Url.Action("Courses", "InstructorDashboard")" class="nav-item @(currentAction == "courses" ? "active" : "")" data-page="courses">
                <span class="material-symbols-outlined nav-icon">school</span>
                My Courses
            </a>
            <a href="@Url.Action("Enrollments", "InstructorDashboard")" class="nav-item @(currentAction == "enrollments" ? "active" : "")" data-page="enrollments">
                <span class="material-symbols-outlined nav-icon">people</span>
                Enrollments
            </a>
            <a href="@Url.Action("Revenue", "InstructorDashboard")" class="nav-item @(currentAction == "revenue" ? "active" : "")" data-page="revenue">
                <span class="material-symbols-outlined nav-icon">trending_up</span>
                Revenue
            </a>
            <a href="@Url.Action("Discussions", "InstructorDashboard")" class="nav-item @(currentAction == "discussions" ? "active" : "")" data-page="discussions">
                <span class="material-symbols-outlined nav-icon">forum</span>
                Q&A/Discussions
            </a>
            <a href="@Url.Action("Analytics", "InstructorDashboard")" class="nav-item @(currentAction == "analytics" ? "active" : "")" data-page="analytics">
                <span class="material-symbols-outlined nav-icon">analytics</span>
                Analytics
            </a>
            <a href="#" class="nav-item" data-page="quizzes">
                <span class="material-symbols-outlined nav-icon">quiz</span>
                Quizzes
            </a>
            <a href="#" class="nav-item" data-page="settings">
                <span class="material-symbols-outlined nav-icon">settings</span>
                Settings
            </a>
        </nav>
    </div>

    <!-- Main Content Area -->
    <div class="instructor-content">
        <div class="content-header">
            <h1>Analytics & Insights</h1>
            <p>Deep dive into your course performance and student engagement metrics.</p>
        </div>

        <!-- Analytics Overview -->
        <div class="analytics-overview">
            <div class="overview-card">
                <div class="overview-icon">
                    <span class="material-symbols-outlined">visibility</span>
                </div>
                <div class="overview-content">
                    <h3>1,247</h3>
                    <p>Total Views</p>
                    <span class="trend positive">+15.3%</span>
                </div>
            </div>
            <div class="overview-card">
                <div class="overview-icon">
                    <span class="material-symbols-outlined">play_circle</span>
                </div>
                <div class="overview-content">
                    <h3>892</h3>
                    <p>Video Plays</p>
                    <span class="trend positive">+8.7%</span>
                </div>
            </div>
            <div class="overview-card">
                <div class="overview-icon">
                    <span class="material-symbols-outlined">timer</span>
                </div>
                <div class="overview-content">
                    <h3>24.5h</h3>
                    <p>Avg. Watch Time</p>
                    <span class="trend positive">+12.1%</span>
                </div>
            </div>
            <div class="overview-card">
                <div class="overview-icon">
                    <span class="material-symbols-outlined">completion_rate</span>
                </div>
                <div class="overview-content">
                    <h3>78.3%</h3>
                    <p>Completion Rate</p>
                    <span class="trend negative">-2.4%</span>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <div class="chart-card">
                <div class="chart-header">
                    <h3>Student Engagement Over Time</h3>
                    <div class="chart-controls">
                        <select id="engagementTimeRange">
                            <option value="7">Last 7 days</option>
                            <option value="30" selected>Last 30 days</option>
                            <option value="90">Last 3 months</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container">
                    <div class="chart-placeholder">
                        <span class="material-symbols-outlined">analytics</span>
                        <h4>Engagement Chart</h4>
                        <p>Interactive chart showing student engagement trends</p>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <h3>Course Performance Comparison</h3>
                    <div class="chart-controls">
                        <select id="performanceMetric">
                            <option value="views">Views</option>
                            <option value="completion" selected>Completion Rate</option>
                            <option value="revenue">Revenue</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container">
                    <div class="chart-placeholder">
                        <span class="material-symbols-outlined">bar_chart</span>
                        <h4>Performance Chart</h4>
                        <p>Bar chart comparing course performance metrics</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Insights -->
        <div class="insights-section">
            <h3>Course Insights</h3>
            <div class="insights-grid">
                <div class="insight-card">
                    <div class="insight-header">
                        <h4>React Fundamentals</h4>
                        <span class="insight-badge positive">Top Performer</span>
                    </div>
                    <div class="insight-stats">
                        <div class="stat-item">
                            <span class="stat-label">Completion Rate</span>
                            <span class="stat-value">85.2%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Avg. Rating</span>
                            <span class="stat-value">4.9/5</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Drop-off Point</span>
                            <span class="stat-value">Lesson 8</span>
                        </div>
                    </div>
                    <div class="insight-actions">
                        <button class="secondary-btn">View Details</button>
                    </div>
                </div>

                <div class="insight-card">
                    <div class="insight-header">
                        <h4>Python for Beginners</h4>
                        <span class="insight-badge neutral">Stable</span>
                    </div>
                    <div class="insight-stats">
                        <div class="stat-item">
                            <span class="stat-label">Completion Rate</span>
                            <span class="stat-value">72.8%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Avg. Rating</span>
                            <span class="stat-value">4.7/5</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Drop-off Point</span>
                            <span class="stat-value">Lesson 12</span>
                        </div>
                    </div>
                    <div class="insight-actions">
                        <button class="secondary-btn">View Details</button>
                    </div>
                </div>

                <div class="insight-card">
                    <div class="insight-header">
                        <h4>Advanced JavaScript</h4>
                        <span class="insight-badge negative">Needs Attention</span>
                    </div>
                    <div class="insight-stats">
                        <div class="stat-item">
                            <span class="stat-label">Completion Rate</span>
                            <span class="stat-value">58.4%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Avg. Rating</span>
                            <span class="stat-value">4.3/5</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Drop-off Point</span>
                            <span class="stat-value">Lesson 5</span>
                        </div>
                    </div>
                    <div class="insight-actions">
                        <button class="secondary-btn">View Details</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Student Behavior Analysis -->
        <div class="behavior-section">
            <h3>Student Behavior Analysis</h3>
            <div class="behavior-grid">
                <div class="behavior-card">
                    <h4>Most Active Hours</h4>
                    <div class="behavior-chart">
                        <div class="chart-placeholder small">
                            <span class="material-symbols-outlined">schedule</span>
                            <p>Peak activity: 7-9 PM</p>
                        </div>
                    </div>
                </div>
                <div class="behavior-card">
                    <h4>Device Usage</h4>
                    <div class="behavior-chart">
                        <div class="chart-placeholder small">
                            <span class="material-symbols-outlined">devices</span>
                            <p>Desktop: 65% | Mobile: 35%</p>
                        </div>
                    </div>
                </div>
                <div class="behavior-card">
                    <h4>Geographic Distribution</h4>
                    <div class="behavior-chart">
                        <div class="chart-placeholder small">
                            <span class="material-symbols-outlined">public</span>
                            <p>Top: US, UK, Canada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/instructor-dashboard.js"></script>
    <script src="~/js/analytics.js"></script>
}
