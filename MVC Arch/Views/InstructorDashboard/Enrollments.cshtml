@{
    ViewData["Title"] = "Enrollments - Instructor Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
}

@section Styles {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css">
    <link rel="stylesheet" href="~/css/enrollments.css">
}

<div class="instructor-layout">
    <!-- Left Sidebar -->
    <div class="instructor-sidebar">
        <div class="sidebar-header">
            <div class="instructor-avatar">
                <div class="avatar-placeholder">JD</div>
            </div>
            <h3>John Doe</h3>
            <p>Instructor</p>
            <a href="#" class="view-profile-link">View Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "InstructorDashboard")" class="nav-item @(currentAction == "index" ? "active" : "")" data-page="dashboard">
                <span class="material-symbols-outlined nav-icon">dashboard</span>
                Dashboard
            </a>
            <a href="@Url.Action("Courses", "InstructorDashboard")" class="nav-item @(currentAction == "courses" ? "active" : "")" data-page="courses">
                <span class="material-symbols-outlined nav-icon">school</span>
                My Courses
            </a>
            <a href="@Url.Action("Enrollments", "InstructorDashboard")" class="nav-item active" data-page="enrollments">
                <span class="material-symbols-outlined nav-icon">people</span>
                Enrollments
            </a>
            <a href="@Url.Action("Revenue", "InstructorDashboard")" class="nav-item @(currentAction == "revenue" ? "active" : "")" data-page="revenue">
                <span class="material-symbols-outlined nav-icon">trending_up</span>
                Revenue
            </a>
            <a href="@Url.Action("Discussions", "InstructorDashboard")" class="nav-item @(currentAction == "discussions" ? "active" : "")" data-page="discussions">
                <span class="material-symbols-outlined nav-icon">forum</span>
                Q&A/Discussions
            </a>
            <a href="@Url.Action("Analytics", "InstructorDashboard")" class="nav-item @(currentAction == "analytics" ? "active" : "")" data-page="analytics">
                <span class="material-symbols-outlined nav-icon">analytics</span>
                Analytics
            </a>
            <a href="#" class="nav-item" data-page="quizzes">
                <span class="material-symbols-outlined nav-icon">quiz</span>
                Quizzes
            </a>
            <a href="#" class="nav-item" data-page="settings">
                <span class="material-symbols-outlined nav-icon">settings</span>
                Settings
            </a>
        </nav>
    </div>

    <!-- Main Content Area -->
    <div class="instructor-content">
        <div class="content-header">
            <h1>Student Enrollments</h1>
            <p>Track student progress and manage course enrollments.</p>
        </div>

        <!-- Enrollment Stats -->
        <div class="enrollment-stats">
            <div class="stat-item">
                <span class="stat-number">1,247</span>
                <span class="stat-label">Total Enrollments</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">892</span>
                <span class="stat-label">Active Students</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">234</span>
                <span class="stat-label">Completed</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">121</span>
                <span class="stat-label">Inactive</span>
            </div>
        </div>

        <!-- Enrollment Filters -->
        <div class="enrollment-filters">
            <div class="filter-group">
                <label for="courseFilter">Course:</label>
                <select id="courseFilter">
                    <option value="">All Courses</option>
                    <option value="react">React Fundamentals</option>
                    <option value="python">Python for Beginners</option>
                    <option value="javascript">Advanced JavaScript</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="statusFilter">Status:</label>
                <select id="statusFilter">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="completed">Completed</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="search-group">
                <input type="text" id="studentSearch" placeholder="Search students...">
                <span class="material-symbols-outlined">search</span>
            </div>
        </div>

        <!-- Enrollments Table -->
        <div class="enrollments-table">
            <table>
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Course</th>
                        <th>Enrollment Date</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="student-info">
                                <div class="student-avatar">SM</div>
                                <div>
                                    <h4>Sarah Miller</h4>
                                    <p>sarah.miller@email.com</p>
                                </div>
                            </div>
                        </td>
                        <td>React Fundamentals</td>
                        <td>Dec 15, 2024</td>
                        <td>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 75%"></div>
                                <span>75%</span>
                            </div>
                        </td>
                        <td><span class="status-badge active">Active</span></td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn" title="View Profile">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                                <button class="action-btn" title="Send Message">
                                    <span class="material-symbols-outlined">message</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="student-info">
                                <div class="student-avatar">MJ</div>
                                <div>
                                    <h4>Mike Johnson</h4>
                                    <p>mike.johnson@email.com</p>
                                </div>
                            </div>
                        </td>
                        <td>Python for Beginners</td>
                        <td>Dec 10, 2024</td>
                        <td>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 45%"></div>
                                <span>45%</span>
                            </div>
                        </td>
                        <td><span class="status-badge active">Active</span></td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn" title="View Profile">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                                <button class="action-btn" title="Send Message">
                                    <span class="material-symbols-outlined">message</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="student-info">
                                <div class="student-avatar">AL</div>
                                <div>
                                    <h4>Anna Lee</h4>
                                    <p>anna.lee@email.com</p>
                                </div>
                            </div>
                        </td>
                        <td>Advanced JavaScript</td>
                        <td>Dec 5, 2024</td>
                        <td>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 100%"></div>
                                <span>100%</span>
                            </div>
                        </td>
                        <td><span class="status-badge completed">Completed</span></td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn" title="View Profile">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                                <button class="action-btn" title="Send Message">
                                    <span class="material-symbols-outlined">message</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/instructor-dashboard.js"></script>
    <script src="~/js/enrollments.js"></script>
}
