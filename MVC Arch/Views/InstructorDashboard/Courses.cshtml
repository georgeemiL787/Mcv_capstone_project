@model IEnumerable<object>
@{
    ViewData["Title"] = "My Courses - Instructor Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css">
    <link rel="stylesheet" href="~/css/courses.css">
}

<div class="instructor-layout">
    <!-- Left Sidebar -->
    <div class="instructor-sidebar">
        <div class="sidebar-header">
            <div class="instructor-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.User?.ProfilePhoto))
            {
                <img src="data:image/jpeg;base64,@ViewBag.User.ProfilePhoto" alt="Profile Photo" class="avatar-image">
            }
            else
            {
                <div class="avatar-placeholder">
                    @(ViewBag.User?.FirstName?.Length > 0 ? ViewBag.User.FirstName[0].ToString().ToUpper() : "U")
                    @(ViewBag.User?.LastName?.Length > 0 ? ViewBag.User.LastName[0].ToString().ToUpper() : "")
                </div>
            }
            </div>
            <h3>John Doe</h3>
            <p>Instructor</p>
            <a href="#" class="view-profile-link">View Profile</a>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">dashboard</span>
                Dashboard
            </a>
            <a href="@Url.Action("Courses", "InstructorDashboard")" class="nav-item active">
                <span class="material-symbols-outlined nav-icon">school</span>
                My Courses
            </a>
            <a href="@Url.Action("Enrollments", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">people</span>
                Enrollments
            </a>
            <a href="@Url.Action("Revenue", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">trending_up</span>
                Revenue
            </a>
            <a href="@Url.Action("Discussions", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">forum</span>
                Q&A/Discussions
            </a>
            <a href="@Url.Action("Analytics", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">analytics</span>
                Analytics
            </a>
            <a href="@Url.Action("Quizzes", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">quiz</span>
                Quizzes
            </a>
            <a href="@Url.Action("Settings", "InstructorDashboard")" class="nav-item">
                <span class="material-symbols-outlined nav-icon">settings</span>
                Settings
            </a>
        </nav>
    </div>

    <!-- Main Content Area -->
    <div class="instructor-content">
        <div class="content-header">
            <h1>My Courses</h1>
            <p>Manage your courses, upload content, and track performance.</p>
            <a href="@Url.Action("Create", "CourseManagement")" class="primary-btn">
                <span class="material-symbols-outlined">add</span>
                Create New Course
            </a>
        </div>

        <!-- Courses Grid -->
        <div class="courses-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (dynamic course in Model)
                {
                    <div class="course-card" data-course-id="@course.Id">
                        <div class="course-image">
                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                <img src="@course.ThumbnailUrl" alt="@course.Title">
                            }
                            else
                            {
                                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="@course.Title">
                            }
                            <div class="course-overlay">
                                <button class="edit-btn" onclick="editCourse(@course.Id)" title="Edit Course">
                                    <span class="material-symbols-outlined">edit</span>
                                </button>
                                <button class="delete-btn" onclick="deleteCourse(@course.Id)" title="Delete Course">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        </div>
                        <div class="course-content">
                            <h3>@course.Title</h3>
                            <p>@course.Description</p>
                            <div class="course-stats">
                                <span><span class="material-symbols-outlined">people</span> @course.StudentCount students</span>
                                <span><span class="material-symbols-outlined">star</span> @course.AverageRating.ToString("F1")</span>
                                <span><span class="material-symbols-outlined">attach_money</span> $@course.Price</span>
                            </div>
                            <div class="course-actions">
                                <button class="secondary-btn" onclick="editCourse(@course.Id)">Edit Course</button>
                                <button class="secondary-btn" onclick="viewAnalytics(@course.Id)">View Analytics</button>
                            </div>
                            @if (!course.IsPublished)
                            {
                                <div class="course-status unpublished">
                                    <span class="material-symbols-outlined">pending</span>
                                    Draft
                                </div>
                            }
                            else if (!course.IsApproved)
                            {
                                <div class="course-status pending">
                                    <span class="material-symbols-outlined">schedule</span>
                                    Pending Approval
                                </div>
                            }
                            else
                            {
                                <div class="course-status published">
                                    <span class="material-symbols-outlined">check_circle</span>
                                    Published
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-courses-message">
                    <div class="empty-state">
                        <span class="material-symbols-outlined">school</span>
                        <h3>No Courses Yet</h3>
                        <p>You haven't created any courses yet. Start building your first course to begin your teaching journey!</p>
                        <a href="@Url.Action("Create", "CourseManagement")" class="primary-btn">
                            <span class="material-symbols-outlined">add</span>
                            Create Your First Course
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/instructor-dashboard.js"></script>
    <script src="~/js/courses.js"></script>
}
