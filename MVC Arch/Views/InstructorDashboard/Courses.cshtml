@{
    ViewData["Title"] = "My Courses - Instructor Dashboard";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css">
    <link rel="stylesheet" href="~/css/courses.css">
}

<div class="instructor-dashboard-container">
    <!-- Page Header -->
    <div class="dashboard-header">
        <h1>My Courses</h1>
        <p>Manage your courses, upload content, and track performance.</p>
        <button class="primary-btn">
            <span class="material-symbols-outlined">add</span>
            Create New Course
        </button>
    </div>

    <!-- Courses Grid -->
    <div class="courses-grid">
        <div class="course-card">
            <div class="course-image">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="React Fundamentals">
                <div class="course-overlay">
                    <button class="edit-btn">
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="delete-btn">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
            </div>
            <div class="course-content">
                <h3>React Fundamentals</h3>
                <p>Learn the basics of React.js and build your first application</p>
                <div class="course-stats">
                    <span><span class="material-symbols-outlined">people</span> 342 students</span>
                    <span><span class="material-symbols-outlined">star</span> 4.9</span>
                    <span><span class="material-symbols-outlined">attach_money</span> $49</span>
                </div>
                <div class="course-actions">
                    <button class="secondary-btn">Edit Course</button>
                    <button class="secondary-btn">View Analytics</button>
                </div>
            </div>
        </div>

        <div class="course-card">
            <div class="course-image">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Python for Beginners">
                <div class="course-overlay">
                    <button class="edit-btn">
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="delete-btn">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
            </div>
            <div class="course-content">
                <h3>Python for Beginners</h3>
                <p>Start your programming journey with Python fundamentals</p>
                <div class="course-stats">
                    <span><span class="material-symbols-outlined">people</span> 567 students</span>
                    <span><span class="material-symbols-outlined">star</span> 4.8</span>
                    <span><span class="material-symbols-outlined">attach_money</span> $39</span>
                </div>
                <div class="course-actions">
                    <button class="secondary-btn">Edit Course</button>
                    <button class="secondary-btn">View Analytics</button>
                </div>
            </div>
        </div>

        <div class="course-card">
            <div class="course-image">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Advanced JavaScript">
                <div class="course-overlay">
                    <button class="edit-btn">
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="delete-btn">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
            </div>
            <div class="course-content">
                <h3>Advanced JavaScript</h3>
                <p>Master advanced JavaScript concepts and modern ES6+ features</p>
                <div class="course-stats">
                    <span><span class="material-symbols-outlined">people</span> 289 students</span>
                    <span><span class="material-symbols-outlined">star</span> 4.7</span>
                    <span><span class="material-symbols-outlined">attach_money</span> $59</span>
                </div>
                <div class="course-actions">
                    <button class="secondary-btn">Edit Course</button>
                    <button class="secondary-btn">View Analytics</button>
                </div>
            </div>
        </div>

        <div class="course-card">
            <div class="course-image">
                <img src="~/assets/images/AdminPanel_assets/Course Management.png" alt="Data Science Fundamentals">
                <div class="course-overlay">
                    <button class="edit-btn">
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="delete-btn">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
            </div>
            <div class="course-content">
                <h3>Data Science Fundamentals</h3>
                <p>Introduction to data analysis, visualization, and machine learning</p>
                <div class="course-stats">
                    <span><span class="material-symbols-outlined">people</span> 423 students</span>
                    <span><span class="material-symbols-outlined">star</span> 4.9</span>
                    <span><span class="material-symbols-outlined">attach_money</span> $79</span>
                </div>
                <div class="course-actions">
                    <button class="secondary-btn">Edit Course</button>
                    <button class="secondary-btn">View Analytics</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/instructor-dashboard.js"></script>
    <script src="~/js/courses.js"></script>
}
